# 가챠 확률: ★ 69.3%, ★★ 29.7%, ★★★ 1%.
# 1성/2성은 기존 비율을 유지하고, 3성은 천장 선택도 가능하다.
for _star, _total in ((1, 69.3), (2, 29.7), (3, 1.0)):
    _grp = [_a for _a in ASPECTS if _a["star"] == _star]
    for _a in _grp:
        _a["w"] = _total / len(_grp)
GACHA_POOL = ASPECTS

