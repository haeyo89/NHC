    # ================================================================
    # 형상해석(가챠) 창 — E 키로 열고 닫으며, 보유 형상을 클릭해 장착한다.
    # ================================================================
    def toggle_gacha(self):
        if self.gacha_open:
            self.close_gacha()
            return
        if self.admin or self.modal or self.codex_open or self.state == "augment_pick":
            return
        self.gacha_open = True
        self.render()

    def close_gacha(self):
        self.gacha_open = False
        self.pity_choice_open = False
        self.pity_choice_tier = 0
        if self.gacha_reveal:
            self.gacha_reveal = None
        self.render()

    def equip_aspect(self, aspect_id):
        aspect = next((item for item in ASPECTS if item["id"] == aspect_id), None)
        if not aspect or aspect_id not in self.owned_aspects:
            return
        unit = self.units.get(aspect["char"])
        if not unit or unit.side != "ally":
            return
        if unit.aspect_id != aspect_id:
            unit.fate_hp_spent = 0
            unit.fate_ready = False
            unit.hero_buff = False
            unit.hero_revive_used = False
            unit.hero_passive_shield_gained = 0
            unit.hero_echo_used = False
            unit.hero_echo_channel = None
            unit.imperial_prayer = 0
            unit.imperial_princess = False
            unit.imperial_command_used = False
            unit.imperial_hope_cooldown = 0
            unit.imperial_guardian_round = None
            unit.imperial_guardian_empty_reward_round = None
            unit.imperial_safety_round = None
            unit.imperial_safety_used = False
            unit.imperial_guardian_target = None
        unit.aspect_id = aspect_id
        self.__dict__.setdefault("equipped", {})[aspect["char"]] = aspect_id
        unit.skills = aspect["skills"]
        unit.max_sp = 10 if aspect_id == "n_imperial" else MAX_SP
        unit.sp = min(unit.sp, unit.max_sp)
        self.gacha_notice = "%s 장착 완료." % aspect["title"]
        self.log("%s에게 [%s] 형상을 장착했다." % (unit.name, aspect["title"]), STAR_COLOR[aspect["star"]])
        self.render()

    def gacha_draw(self, count, cost):
        if self.aspect_shards < cost:
            return
        self.aspect_shards -= cost
        total = sum(a["w"] for a in GACHA_POOL)
        results = []
        for _ in range(count):
            r = random.random() * total
            pick = GACHA_POOL[-1]
            for a in GACHA_POOL:
                if r < a["w"]:
                    pick = a
                    break
                r -= a["w"]
            results.append((pick, pick["id"] not in self.owned_aspects))
            self.owned_aspects.add(pick["id"])
        self.aspect_pity += count
        self.gacha_results = results
        self.gacha_notice = ""
        self.gacha_reveal = {"revealed": 0, "index": 0, "frame": 0}
        self.log("형상해석 %d회 (조각 -%d) — ★★ %d개" %
                 (count, cost, sum(1 for a, _ in results if a["star"] >= 2)), SPC)
        beep([(880, 50), (1046, 60), (1318, 90)], self.sound)
        self.render()
        self.schedule(28, self.gacha_reveal_step)

    def gacha_reveal_step(self):
        reveal = self.gacha_reveal
        if not self.gacha_open or not reveal:
            return
        pause_ms = 28
        reveal["frame"] += 1
        if reveal["frame"] >= 8:
            result_index = reveal["revealed"]
            pick = self.gacha_results[result_index][0]
            reveal["revealed"] += 1
            reveal["index"] += 1
            reveal["frame"] = 0
            if pick["star"] == 3:
                self.gacha_notice = "★★★ 형상 등장! %s" % pick["title"]
                self.log("★★★ 형상 등장! [%s]" % pick["title"], STAR_COLOR[3])
                self.fx_gacha_rare(result_index, pick)
                beep([(523, 80), (784, 90), (1046, 100), (1568, 240)], self.sound)
                pause_ms = 1250
            if reveal["revealed"] >= len(self.gacha_results):
                self.gacha_reveal = None
            elif pause_ms == 28:
                beep([(523, 25), (784, 40)], self.sound)
        self.render()
        if self.gacha_reveal:
            self.schedule(pause_ms, self.gacha_reveal_step)

    def skip_gacha_reveal(self):
        if not self.gacha_reveal:
            return
        self.gacha_reveal = None
        self.render()

    def gacha_pity_exchange(self, tier):
        if tier not in (2, 3):
            return
        threshold = GACHA_PITY_TIER2 if tier == 2 else GACHA_PITY_TIER3
        options = self.unowned_tier_aspects(tier)
        if tier == 2 and self.pity_tier2_claimed:
            self.gacha_notice = "★★ 천장은 이미 수령했다. 형상파편 스택은 유지 중이다."
        elif self.aspect_pity < threshold:
            self.gacha_notice = "형상파편 %d개가 필요하다." % threshold
        elif not options:
            self.gacha_notice = "보유하지 않은 %s 형상이 없어 선택할 수 없다." % ("★★" if tier == 2 else "★★★")
        else:
            self.pity_choice_open = True
            self.pity_choice_tier = tier
            self.gacha_notice = ""
        self.render()

    def unowned_tier_aspects(self, tier):
        return [aspect for aspect in ASPECTS
                if aspect["star"] == tier and aspect["id"] not in self.owned_aspects]

    def unowned_tier2_aspects(self):
        return self.unowned_tier_aspects(2)

    def gacha_claim_pity_aspect(self, aspect_id):
        tier = self.pity_choice_tier
        if tier not in (2, 3):
            return
        threshold = GACHA_PITY_TIER2 if tier == 2 else GACHA_PITY_TIER3
        aspect = next((item for item in self.unowned_tier_aspects(tier)
                       if item["id"] == aspect_id), None)
        if (not self.pity_choice_open or tier not in (2, 3)
                or (tier == 2 and self.pity_tier2_claimed)
                or self.aspect_pity < threshold or not aspect):
            return
        self.owned_aspects.add(aspect_id)
        if tier == 2:
            self.pity_tier2_claimed = True
            self.gacha_notice = "★★ 천장 수령 완료: %s · 형상파편 %d개 유지" % (
                aspect["title"], self.aspect_pity)
            self.log("★★ 천장으로 [%s] 형상을 선택했다. 형상파편 스택 %d 유지." %
                     (aspect["title"], self.aspect_pity), STAR_COLOR[2])
        else:
            self.aspect_pity = 0
            self.pity_tier2_claimed = False
            self.gacha_notice = "★★★ 천장 수령: %s · 형상파편 스택 초기화" % aspect["title"]
            self.log("★★★ 천장으로 [%s] 형상을 선택했다. 형상파편 스택 초기화." %
                     aspect["title"], STAR_COLOR[3])
        self.pity_choice_open = False
        self.pity_choice_tier = 0
        self.gacha_results = [(aspect, True)]
        beep([(784, 60), (1046, 70), (1318, 120)], self.sound)
        self.render()

    def close_pity_choice(self):
        self.pity_choice_open = False
        self.pity_choice_tier = 0
        self.render()

    def render_pity_choice(self):
        tier = self.pity_choice_tier
        options = self.unowned_tier_aspects(tier)
        star_text = "★★" if tier == 2 else "★★★"
        threshold = GACHA_PITY_TIER2 if tier == 2 else GACHA_PITY_TIER3
        star_color = STAR_COLOR[tier]
        self.buttons = []
        self.canvas.create_rectangle(0, 0, WIN_W, WIN_H, fill="#000000", outline="",
                                     stipple="gray50", tags="ui")
        bx, by, bw, bh = WIN_W / 2 - 390, 190, 780, 430
        self.canvas.create_rectangle(bx, by, bx + bw, by + bh, fill=PANEL,
                                     outline=star_color, width=2, tags="ui")
        self.txt(WIN_W / 2, by + 28, star_text + " 천장 형상 선택", 24, star_color,
                 bold=True, anchor="center")
        stack_note = "형상파편 %d개 유지" % self.aspect_pity if tier == 2 \
            else "선택하면 형상파편 스택이 0으로 초기화됩니다"
        self.txt(WIN_W / 2, by + 60, "미보유 형상 중 하나를 선택하세요 · " + stack_note,
                 12, MUT, mono=True, anchor="center")
        gap = 12
        option_w = (bw - 48 - gap * 2) / 3
        option_y = by + 95
        for index, aspect in enumerate(options):
            option_x = bx + 24 + (index % 3) * (option_w + gap)
            option_row_y = option_y + (index // 3) * 112
            self.gbtn(option_x, option_row_y, option_w, 100,
                      star_text + "  " + aspect["title"], "캐릭터 " + aspect["char"],
                      lambda aid=aspect["id"]: self.gacha_claim_pity_aspect(aid),
                      star_color, True, 10 + index)
        if not options:
            self.txt(WIN_W / 2, option_y + 52, "선택 가능한 " + star_text + " 형상이 없습니다.",
                     14, MUT, anchor="center")
        self.gbtn(WIN_W / 2 - 70, by + bh - 52, 140, 34,
                  "취소", None, self.close_pity_choice, MUT, True, 19)

    def gbtn(self, x, y, w, h, label, sub, cb, color, enabled, idx):
        hovered = enabled and self.hover == ("gch", idx)
        self.canvas.create_rectangle(x, y, x + w, y + h, fill=PANEL2 if hovered else PANEL,
                                     outline=color if enabled else BRD,
                                     width=2 if hovered else 1, tags="ui")
        tc = color if enabled else MUT
        if sub:
            self.txt(x + w / 2, y + h / 2 - 9, label, 15, tc, bold=True, anchor="center")
            self.txt(x + w / 2, y + h / 2 + 11, sub, 10, MUT, mono=True, anchor="center")
        else:
            self.txt(x + w / 2, y + h / 2, label, 12, tc, mono=True, anchor="center")
        self.buttons.append(dict(x=x, y=y, w=w, h=h, key=("gch", idx),
                                 cb=(cb if enabled else (lambda: None))))

    def aspect_tip_lines(self, a):
        if a["id"] == "c_underboss":
            return self.underboss_tip_lines()
        if a["id"] == "h_maestro":
            return self.maestro_tip_lines()
        if a["id"] == "n_bigsis":
            return self.bigsis_tip_lines()
        if a["id"] == "h_oracle":
            return self.oracle_tip_lines()
        lines = []
        if a.get("desc"):
            lines.append(a["desc"])
        if a["id"] == "c_fate_lost":
            lines.append("패시브: 적 처치 시 체력 30 회복 · 체력 소비 100마다 필연 획득")
            lines.append("필연 보유 시 스킬 3이 [운명]으로 변경(전투당 1회):")
            lines.append("기본 공격·방어·회피·라운드 시작 SP 회복 불가")
            lines.append("스킬 3-2:[운명] 이 스킬은 사용시 스킬포인트를 소모하지 않음,모든 대상에게 80 피해, 운명 3 부여")
        elif a["id"] == "h_hero":
            lines.append("피해의 10%만큼 보호막 획득 (이 효과로 최대 체력의 50% 까지만 획득)")
            lines.append("사망 시 최대 체력으로 부활(전투 당 1회) · 영웅 버프 획득")
            lines.append("영웅: 보호막이 최대체력을 초과하여 부여될 수 있음 · 스킬 피해의 10% 보호막 획득")
            lines.append("영웅 버프 중 스킬 3이 [잔상보]로 변경(전투당 1회)")
            lines.append("잔상보: 한 턴 3회 공격 · 첫 타격은 지정 대상, 다음 2회는 무작위 적 · 총 최대 180 피해")
            lines.append("잔상보 시전 중 기절/격파/사망하면 중단")
        elif a["id"] == "n_imperial":
            lines.append("패시브: 기본 SP 10 · 외부 효과로 SP 증가 불가 (수호령 사용시 2 획득)")
            lines.append("수호령 사용 즉시 기도 +20 · 전이된 피해만큼 기도 추가 획득")
            lines.append("왕녀 상태가 아니면 일반 공격(수호령)·방어·회피 외 행동 불가")
            lines.append("기도 120 → 왕녀: SP 최대 · 매턴 체력 +10 · SP +4 · 해당 턴동안 사망하지 않음")
            lines.append("왕녀 상태에서 스킬 3이 [(관측불가) 섬멸 명령]으로 변경(전투당 1회)")
            lines.append("스킬 3-2 [(관측불가) 섬멸 명령]-모든 적에게 100 고정 피해(방어 행동을 무시함)")
        for i, sk in enumerate(a["skills"], 1):
            if sk.get("shield_cost"):
                cost = "보호막 %d + SP %d" % (sk["shield_cost"], sk["cost"])
            elif sk.get("hp_cost"):
                cost = "체력 %d 소비" % sk["hp_cost"]
            elif sk["kind"] == "fate_ultimate":
                cost = "필연 소비"
            elif sk["kind"] == "hero_echo":
                cost = "자원 없음"
            else:
                cost = "%d포인트 소비" % sk["cost"]
            lines.append("스킬 %d: %s [%s]" % (i, sk["name"], cost))
            for part in sk["desc"].split(" / "):
                lines.append("   " + part)
        return lines

    def draw_aspect_tip(self, a):
        c = STAR_COLOR.get(a["star"], TXT)
        title = "%s  %s" % ("★" * a["star"], a["title"])
        lines = self.aspect_tip_lines(a)
        tf, lf = self.font(15, bold=True), self.font(11, mono=True)
        lines = self.wrap_lines(lines, lf, 560)
        tw = max([tf.measure(title)] + [lf.measure(l) for l in lines]) + 24
        lh = lf.metrics("linespace") + 3
        th = 12 + tf.metrics("linespace") + 6 + len(lines) * lh + 10
        mx, my = self.mouse
        bx = min(max(8, mx + 16), WIN_W - tw - 8)
        by = my + 22
        if by + th > WIN_H - 8:
            by = max(8, my - th - 14)
        self.canvas.create_rectangle(bx + 3, by + 3, bx + tw + 3, by + th + 3,
                                     fill="#0A0C10", outline="", stipple="gray50", tags="ui")
        self.canvas.create_rectangle(bx, by, bx + tw, by + th, fill=PANEL2, outline=c,
                                     width=2, tags="ui")
        self.txt(bx + 12, by + 8, title, 15, c, bold=True)
        ty = by + 8 + tf.metrics("linespace") + 6
        for l in lines:
            self.txt(bx + 12, ty, l, 11, TXT if l.startswith("스킬") else MUT, mono=True)
            ty += lh

    def render_gacha(self):
        if not self.gacha_open:
            return
        self.buttons = []     # 뒤쪽 버튼이 눌리지 않도록 교체
        self.canvas.create_rectangle(0, 0, WIN_W, WIN_H, fill="#000000", outline="",
                                     stipple="gray75", tags="ui")
        pw, ph = 900, 660
        px, py = (WIN_W - pw) / 2, 30
        self.canvas.create_rectangle(px + 5, py + 5, px + pw + 5, py + ph + 5,
                                     fill="#05070A", outline="", stipple="gray50", tags="ui")
        self.canvas.create_rectangle(px, py, px + pw, py + ph, fill=PANEL, outline=SHLD,
                                     width=2, tags="ui")
        self.canvas.create_rectangle(px, py, px + pw, py + 5, fill=SHLD, outline="", tags="ui")
        ix, iw = px + 24, pw - 48

        self.txt(ix, py + 14, "형상해석", 28, TXT, bold=True)
        self.txt(ix + 140, py + 28, "조각으로 형상을 해석한다", 12, MUT, mono=True)
        self.txt(px + pw - 24, py + 24, "[E] / [ESC] 닫기", 11, MUT, mono=True, anchor="ne")

        # 재화
        for i, (label, val, color) in enumerate([("조각", self.aspect_shards, SPC),
                                                  ("형상파편", self.aspect_pity, SHLD)]):
            bx = ix + i * 232
            self.canvas.create_rectangle(bx, py + 64, bx + 220, py + 114, fill=PANEL2,
                                         outline=BRD, tags="ui")
            self.txt(bx + 14, py + 70, label, 11, MUT, mono=True)
            self.txt(bx + 14, py + 86, str(val), 20, color, bold=True)

        # 확률
        self.txt(ix, py + 128, "확률", 11, MUT, mono=True)
        self.txt(ix + 50, py + 127, "★  69.3%", 13, STAR_COLOR[1], bold=True)
        self.txt(ix + 160, py + 127, "★★  29.7%", 13, STAR_COLOR[2], bold=True)
        self.txt(ix + 278, py + 127, "★★★  1%", 13, STAR_COLOR[3], bold=True)

        # 형상 도감으로 이동 (장착은 도감에서)
        self.gbtn(ix, py + 142, 230, 30, "형상 도감 열기 · 장착 ▶", None,
                  self.open_aspect_codex, SHLD, True, 6)
        self.txt(ix + 246, py + 150, "해석한 형상은 도감에서 장착한다", 11, MUT, mono=True)

        # 해석 버튼
        bw = (iw - 12) / 2
        can_draw = not self.gacha_reveal
        self.gbtn(ix, py + 180, bw, 66, "1회 해석", "조각 %d 소모" % GACHA_COST_SINGLE,
                  lambda: self.gacha_draw(1, GACHA_COST_SINGLE), SPC,
              self.aspect_shards >= GACHA_COST_SINGLE and can_draw, 0)
        self.gbtn(ix + bw + 12, py + 180, bw, 66, "10회 해석  (+1회 보너스)",
                  "조각 %d 소모 · 총 11회 해석" % GACHA_COST_TEN,
                  lambda: self.gacha_draw(11, GACHA_COST_TEN), SPC,
              self.aspect_shards >= GACHA_COST_TEN and can_draw, 1)

        # 형상파편 진행도
        y0 = py + 268
        self.txt(ix, y0, "형상파편  (해석 1회당 +1 · ★★ 수령 시 스택 유지)", 12, TXT, bold=True)
        by = y0 + 26
        self.canvas.create_rectangle(ix, by, ix + iw, by + 16, fill=PANEL2, outline=BRD, tags="ui")
        ratio = min(1.0, self.aspect_pity / float(GACHA_PITY_TIER3))
        if ratio > 0:
            self.canvas.create_rectangle(ix + 1, by + 1, ix + 1 + (iw - 2) * ratio, by + 15,
                                         fill=SHLD, outline="", tags="ui")
        x200 = ix + iw * GACHA_PITY_TIER2 / float(GACHA_PITY_TIER3)
        self.canvas.create_line(x200, by - 4, x200, by + 20, fill=STAR_COLOR[2], width=2, tags="ui")
        tier2_label = "%d  ★★ 수령 완료" % GACHA_PITY_TIER2 if self.pity_tier2_claimed \
            else "%d  ★★ 선택 가능" % GACHA_PITY_TIER2
        self.txt(x200, by + 22, tier2_label, 10, STAR_COLOR[2],
                 mono=True, anchor="n")
        self.txt(ix + iw, by + 22, "%d  ★★★ 선택" % GACHA_PITY_TIER3, 10, STAR_COLOR[3],
                 mono=True, anchor="ne")

        ey = y0 + 68
        tier2_options = self.unowned_tier2_aspects()
        if self.pity_tier2_claimed:
            tier2_button = "★★ 천장 수령 완료"
        elif not tier2_options:
            tier2_button = "★★ 형상 보유 완료"
        else:
            tier2_button = "★★ 원하는 형상 선택  (%d)" % GACHA_PITY_TIER2
        self.gbtn(ix, ey, bw, 42, tier2_button, None,
                  lambda: self.gacha_pity_exchange(2), STAR_COLOR[2],
                  self.aspect_pity >= GACHA_PITY_TIER2 and can_draw
                  and not self.pity_tier2_claimed and bool(tier2_options), 2)
        self.gbtn(ix + bw + 12, ey, bw, 42,
                  "★★★ 원하는 형상 선택  (%d)" % GACHA_PITY_TIER3, None,
                  lambda: self.gacha_pity_exchange(3), STAR_COLOR[3],
                  self.aspect_pity >= GACHA_PITY_TIER3 and can_draw
                  and bool(self.unowned_tier_aspects(3)), 3)
        if self.gacha_notice:
            self.txt(ix, ey + 50, self.gacha_notice, 11, SPC, mono=True)

        # 해석 결과 (카드에 마우스를 올리면 스킬 확인)
        y1 = py + 414
        self.txt(ix, y1, "해석 결과", 12, TXT, bold=True)
        if self.gacha_reveal:
            self.gbtn(ix + iw - 116, y1 - 6, 116, 26, "연출 스킵", None,
                      self.skip_gacha_reveal, SPC, True, 5)
        if not self.gacha_results:
            self.txt(ix + iw / 2, y1 + 70, "아직 해석 기록이 없다.", 13, MUT, mono=True,
                     anchor="center")
        cw, ch = (iw - 5 * 10) / 6, 64
        revealed = self.gacha_reveal["revealed"] if self.gacha_reveal else len(self.gacha_results)
        for i, (pick, is_new) in enumerate(self.gacha_results):
            cx = ix + (i % 6) * (cw + 10)
            cy = y1 + 24 + (i // 6) * (ch + 10)
            c = STAR_COLOR.get(pick["star"], TXT)
            hov = self.hover == ("gcard", i)
            active_reveal = self.gacha_reveal and i == self.gacha_reveal["index"]
            face_up = i < revealed or (active_reveal and self.gacha_reveal["frame"] >= 4)
            card_w = cw
            if active_reveal:
                frame = self.gacha_reveal["frame"]
                card_w *= max(0.06, abs((frame - 4) / 4.0))
            card_x = cx + (cw - card_w) / 2
            if face_up:
                self.canvas.create_rectangle(card_x, cy, card_x + card_w, cy + ch,
                                             fill=PANEL if hov else PANEL2, outline=c,
                                             width=2 if (pick["star"] >= 2 or hov) else 1, tags="ui")
                if card_w > cw * 0.45:
                    self.txt(cx + cw / 2, cy + 14, "★" * pick["star"], 12, c,
                             bold=True, anchor="center")
                    self.txt(cx + cw / 2, cy + 33, pick["title"], 13, TXT,
                             bold=True, anchor="center")
                if i < revealed and not self.gacha_reveal:
                    unit = self.units.get(pick["char"])
                    equipped = bool(unit and unit.aspect_id == pick["id"])
                    status = "장착 중" if equipped else "클릭해 장착"
                    self.txt(cx + cw / 2, cy + 52, status, 10, HEAL if equipped else MUT,
                             mono=True, anchor="center")
                    callback = lambda aid=pick["id"]: self.equip_aspect(aid)
                    self.buttons.append(dict(x=cx, y=cy, w=cw, h=ch,
                                             key=("gcard", i), cb=callback))
                elif card_w > cw * 0.45:
                    label = "NEW" if is_new else "중복 해석"
                    self.txt(cx + cw / 2, cy + 52, label, 10, SPC if is_new else MUT,
                             mono=True, anchor="center")
            else:
                self.canvas.create_rectangle(card_x, cy, card_x + card_w, cy + ch,
                                             fill=PANEL, outline=SHLD, width=2, tags="ui")
                if card_w > cw * 0.45:
                    self.txt(cx + cw / 2, cy + 32, "✦", 24, SHLD, bold=True, anchor="center")

        # 하단
        fy = py + ph - 62
        self.gbtn(ix + iw - 140, fy, 140, 34, "닫기", None, self.close_gacha, MUT, True, 4)
        self.txt(ix, fy + 9, "※ 적 처치 +10 · 스테이지 클리어 +100 조각  |  추가 조정: 어드민 패널(maki)",
             11, MUT, mono=True)
        self.txt(px + pw / 2, py + ph - 18,
             "※ 해석 결과에서 보유 형상을 클릭하면 장착할 수 있다. (도감은 F 키 → 서재)",
             10, MUT, mono=True, anchor="center")

        h = self.hover
        if isinstance(h, tuple):
            if h[0] == "gdex" and h[1] < len(ASPECTS):
                self.draw_aspect_tip(ASPECTS[h[1]])
            elif h[0] == "gcard" and h[1] < len(self.gacha_results):
                self.draw_aspect_tip(self.gacha_results[h[1]][0])
        if self.pity_choice_open:
            self.render_pity_choice()

    # ================================================================
    # 전투효과 도감 — F 키로 열고 닫는다. 칩에 마우스를 올리면 설명, 클릭하면 아래에 고정.
    # ================================================================
    def toggle_codex(self):
        if self.codex_open:
            self.close_codex()
            return
        if (self.admin or self.admin_kill_pending or self.modal or self.gacha_open
                or self.state == "augment_pick"):
            return
        self.codex_open = True
        self.codex_page = "menu"
        self.codex_sel = None
        self.render()

    def close_codex(self):
        self.codex_open = False
        self.render()

    def select_effect(self, idx):
        self.codex_sel = None if self.codex_sel == idx else idx
        self.render()

    def effect_holders(self, eid):
        """지금 이 효과가 걸려 있는 유닛 목록."""
        checks = {
            "guard": lambda u: u.status == "guard",
            "evade": lambda u: u.status == "evade",
            "shield": lambda u: u.shield > 0,
            "focus": lambda u: bool(u.focused),
            "undying": lambda u: u.immortal_turns > 0,
            "broken": lambda u: u.broken,
            "curse": lambda u: u.curse_turns > 0,
            "stun": lambda u: u.stun_turns > 0,
            "fate": lambda u: u.fate_turns > 0,
            "speed_penalty": lambda u: u.speed_penalty > 0,
            "speed_minus": lambda u: u.speed_minus > 0,
            "speed_fix": lambda u: u.speed_fix,
            "paint": lambda u: u.paint > 0,
            "fun": lambda u: u.fun_turns > 0,
            "danger": lambda u: u.danger_turns > 0,
            "necessity": lambda u: self.is_fate_c(u) and u.fate_ready,
            "hero": lambda u: self.is_hero_h(u) and u.hero_buff,
            "echo": lambda u: self.is_hero_h(u) and bool(u.hero_echo_channel),
            "prayer": lambda u: (self.is_imperial_n(u) and not u.imperial_princess
                                 and u.imperial_prayer > 0),
            "guardian": lambda u: (self.is_imperial_n(u)
                                   and u.imperial_guardian_round == self.round),
            "princess": lambda u: self.is_imperial_n(u) and u.imperial_princess,
        }
        fn = checks.get(eid)
        if not fn:
            return []
        return [u for u in self.units.values() if u.alive and fn(u)]

    def draw_effect_tip(self, e):
        c = e["color"]
        title = e["name"]
        lines = [e["scope"], ""] + e["desc"].split(" / ")
        holders = self.effect_holders(e["id"])
        lines.append("")
        lines.append("현재 적용 중: " + (", ".join(u.name for u in holders) if holders else "없음"))
        tf, lf = self.font(15, bold=True), self.font(11, mono=True)
        lines = self.wrap_lines(lines, lf, 480)
        tw = max([tf.measure(title)] + [lf.measure(l) for l in lines]) + 24
        lh = lf.metrics("linespace") + 3
        th = 12 + tf.metrics("linespace") + 6 + len(lines) * lh + 10
        mx, my = self.mouse
        bx = min(max(8, mx + 16), WIN_W - tw - 8)
        by = my + 22
        if by + th > WIN_H - 8:
            by = max(8, my - th - 14)
        self.canvas.create_rectangle(bx + 3, by + 3, bx + tw + 3, by + th + 3,
                                     fill="#0A0C10", outline="", stipple="gray50", tags="ui")
        self.canvas.create_rectangle(bx, by, bx + tw, by + th, fill=PANEL2, outline=c,
                                     width=2, tags="ui")
        self.txt(bx + 12, by + 8, title, 15, c, bold=True)
        ty = by + 8 + tf.metrics("linespace") + 6
        for i, l in enumerate(lines):
            color = c if i == 0 else (HEAL if l.startswith("현재 적용 중") and holders else MUT)
            self.txt(bx + 12, ty, l, 11, color, mono=True)
            ty += lh

    def codex_back(self):
        self.codex_page = "menu"
        self.codex_sel = None
        self.render()

    def codex_esc(self):
        if self.codex_page == "workshop":
            self.close_codex()
        elif self.codex_page == "char":
            self.codex_page = "char_select"
            self.render()
        elif self.codex_page != "menu":
            self.codex_back()
        else:
            self.close_codex()

    def codex_goto(self, page):
        self.codex_page = page
        self.codex_sel = None
        if page == "aspect":
            self.gacha_notice = ""
        self.render()

    def render_codex(self):
        if not self.codex_open:
            return
        if self.codex_page == "effect":
            self.render_effect_codex()
        elif self.codex_page == "aspect":
            self.render_aspect_codex()
        elif self.codex_page == "char_select":
            self.render_char_select()
        elif self.codex_page == "char":
            self.render_char_page()
        elif self.codex_page == "workshop":
            self.render_workshop()
        else:
            self.render_library_menu()

    def render_library_menu(self):
        self.buttons = []
        self.canvas.create_rectangle(0, 0, WIN_W, WIN_H, fill="#000000", outline="",
                                     stipple="gray75", tags="ui")
        pw, ph = 800, 330
        px, py = (WIN_W - pw) / 2, 250
        self.canvas.create_rectangle(px + 5, py + 5, px + pw + 5, py + ph + 5,
                                     fill="#05070A", outline="", stipple="gray50", tags="ui")
        self.canvas.create_rectangle(px, py, px + pw, py + ph, fill=PANEL, outline=SPC,
                                     width=2, tags="ui")
        self.canvas.create_rectangle(px, py, px + pw, py + 5, fill=SPC, outline="", tags="ui")
        self.txt(px + 24, py + 16, "서재", 30, TXT, bold=True)
        self.txt(px + 24, py + 62, "열람할 도감을 고르세요", 12, MUT, mono=True)
        self.txt(px + pw - 24, py + 24, "[F] / [ESC] 닫기", 11, MUT, mono=True, anchor="ne")
        self.canvas.create_line(px + 24, py + 84, px + pw - 24, py + 84, fill=BRD, tags="ui")

        bw, bh, gap = (pw - 48 - 32) / 3, 190, 16
        by = py + 104
        entries = [
            ("전투효과 도감", "버프 · 디버프 · 형상 고유 효과 %d종" % len(EFFECTS), BRKC, "effect"),
            ("형상 도감", "보유 %d/%d · 클릭해 장착" % (len(self.owned_aspects), len(ASPECTS)),
             SHLD, "aspect"),
            ("등장인물 도감", "N · H · C  컨셉 아트와 설명", ROSE, "char_select"),
        ]
        for i, (name, sub, color, page) in enumerate(entries):
            bx = px + 24 + i * (bw + gap)
            hov = self.hover == ("lib", i)
            self.canvas.create_rectangle(bx, by, bx + bw, by + bh,
                                         fill=PANEL2 if hov else PANEL, outline=color,
                                         width=3 if hov else 2, tags="ui")
            self.canvas.create_rectangle(bx, by, bx + bw, by + 6, fill=color, outline="",
                                         tags="ui")
            self.txt(bx + bw / 2, by + bh / 2 - 12, name, 22, color, bold=True, anchor="center")
            self.txt(bx + bw / 2, by + bh / 2 + 24, sub, 11, MUT, mono=True, anchor="center")
            self.buttons.append(dict(x=bx, y=by, w=bw, h=bh, key=("lib", i),
                                     cb=(lambda p=page: self.codex_goto(p))))

    def render_aspect_codex(self):
        self.buttons = []
        self.canvas.create_rectangle(0, 0, WIN_W, WIN_H, fill="#000000", outline="",
                                     stipple="gray75", tags="ui")
        pw, ph = 900, 440
        px, py = (WIN_W - pw) / 2, 130
        self.canvas.create_rectangle(px + 5, py + 5, px + pw + 5, py + ph + 5,
                                     fill="#05070A", outline="", stipple="gray50", tags="ui")
        self.canvas.create_rectangle(px, py, px + pw, py + ph, fill=PANEL, outline=SHLD,
                                     width=2, tags="ui")
        self.canvas.create_rectangle(px, py, px + pw, py + 5, fill=SHLD, outline="", tags="ui")
        ix, iw = px + 24, pw - 48

        self.txt(ix, py + 14, "형상 도감", 28, TXT, bold=True)
        self.txt(ix + 170, py + 28, "보유 형상을 클릭해 장착 · 마우스를 올리면 스킬 확인", 12, MUT,
                 mono=True)
        self.txt(px + pw - 24, py + 24, "[F] 닫기 · [ESC] 서재로", 11, MUT, mono=True, anchor="ne")
        self.canvas.create_line(ix, py + 60, ix + iw, py + 60, fill=BRD, tags="ui")

        per_row, gap, ch = 5, 8, 64
        cw = (iw - (per_row - 1) * gap) / per_row
        y0 = py + 72
        for i, a in enumerate(ASPECTS):
            dx = ix + (i % per_row) * (cw + gap)
            dy = y0 + (i // per_row) * (ch + gap)
            owned = a["id"] in self.owned_aspects
            c = STAR_COLOR.get(a["star"], TXT)
            hov = self.hover == ("adx", i)
            self.canvas.create_rectangle(dx, dy, dx + cw, dy + ch,
                                         fill=PANEL2 if hov else PANEL,
                                         outline=c if owned else BRD,
                                         width=2 if (hov or a["star"] >= 2 and owned) else 1,
                                         tags="ui")
            self.txt(dx + cw / 2, dy + 13, "★" * a["star"], 11, c if owned else MUT,
                     bold=True, anchor="center")
            self.txt(dx + cw / 2, dy + 31, a["title"], 13, TXT if owned else MUT,
                     bold=True, anchor="center")
            unit = self.units.get(a["char"])
            equipped = bool(unit and unit.aspect_id == a["id"])
            status = "장착 중" if equipped else ("클릭해 장착" if owned else "미보유")
            self.txt(dx + cw / 2, dy + 50, status, 10, HEAL if equipped else MUT,
                     mono=True, anchor="center")
            cb = (lambda aid=a["id"]: self.equip_aspect(aid)) if owned else (lambda: None)
            self.buttons.append(dict(x=dx, y=dy, w=cw, h=ch, key=("adx", i), cb=cb))

        rows = (len(ASPECTS) + per_row - 1) // per_row
        sy = y0 + rows * (ch + gap) + 6
        parts = []
        for cid in ("N", "H", "C"):
            unit = self.units.get(cid)
            asp = next((x for x in ASPECTS if unit and x["id"] == unit.aspect_id), None)
            parts.append("%s: %s" % (cid, asp["title"] if asp else "-"))
        self.txt(ix, sy, "장착 중 — " + "  ·  ".join(parts), 12, TXT, mono=True)
        if self.gacha_notice:
            self.txt(ix, sy + 24, self.gacha_notice, 11, SPC, mono=True)

        bx = px + pw / 2 - 70
        self.canvas.create_rectangle(bx, py + ph - 44, bx + 140, py + ph - 10,
                                     fill=PANEL2 if self.hover == ("adx", -1) else PANEL,
                                     outline=MUT, tags="ui")
        self.txt(bx + 70, py + ph - 27, "← 서재로", 12, MUT, mono=True, anchor="center")
        self.buttons.append(dict(x=bx, y=py + ph - 44, w=140, h=34, key=("adx", -1),
                                 cb=self.codex_back))

        h = self.hover
        if isinstance(h, tuple) and h[0] == "adx" and 0 <= h[1] < len(ASPECTS):
            self.draw_aspect_tip(ASPECTS[h[1]])

    def codex_open_char(self, cid):
        self.codex_char = cid
        self.codex_char_page = 0
        self.codex_img_tab = 0
        self.codex_scroll = 0
        self.codex_page = "char"
        self.render()

    def codex_set_tab(self, k):
        self.codex_img_tab = k
        self.codex_scroll = 0
        self.render()

    def codex_set_char_page(self, p):
        self.codex_char_page = p
        self.codex_img_tab = 0
        self.codex_scroll = 0
        self.render()

    # ---- 스토리 스크롤 ----
    def char_texts(self, data, page):
        """(짧은 설명, 스토리). 'story' 키가 있으면 그것을, 2페이지는 desc 의 첫 빈 줄 뒤를 스토리로 쓴다."""
        desc = data.get("desc", "")
        if "story" in data:
            return desc, data["story"] or ""
        if page == 1:
            head, sep, tail = desc.partition("\n\n")
            if sep and tail.strip():
                return head, tail
        return desc, ""

    def wrap_story(self, text, font, maxw):
        out = []
        for para in text.split("\n"):
            if not para.strip():
                out.append("")
                continue
            cur = ""
            for ch in para:
                if cur and font.measure(cur + ch) > maxw:
                    cut = cur.rfind(" ")
                    if cut > len(cur) * 0.6:
                        out.append(cur[:cut])
                        cur = cur[cut + 1:]
                    else:
                        out.append(cur)
                        cur = ""
                cur += ch
            out.append(cur)
        return out

    def char_key(self, ev):
        """등장인물 페이지에서 ← → 로 1페이지/2페이지 전환."""
        if not (self.codex_open and self.codex_page == "char"):
            return False
        c = next((x for x in CHARACTERS if x["id"] == getattr(self, "codex_char", "N")), None)
        if not c or not c.get("special"):
            return False
        if ev.keysym == "Left":
            self.codex_set_char_page(0)
        elif ev.keysym == "Right":
            self.codex_set_char_page(1)
        else:
            return False
        return True

    def story_active(self):
        return bool(self.codex_open and self.codex_page == "char" and self.__dict__.get("_story"))

    def story_scroll_to(self, n):
        st = self._story
        mx = max(0, st["total"] - st["vis"])
        self.codex_scroll = max(0, min(mx, int(n)))
        self.render()

    def story_scroll_by(self, d):
        if self.story_active():
            self.story_scroll_to(getattr(self, "codex_scroll", 0) + d)

    def on_wheel(self, ev):
        if not self.story_active():
            return
        num = getattr(ev, "num", None)
        if num == 4:
            step = -3
        elif num == 5:
            step = 3
        else:
            d = getattr(ev, "delta", 0)
            if not d:
                return
            step = -3 if d > 0 else 3
        self.story_scroll_by(step)

    def story_key(self, ev):
        if not self.story_active():
            return False
        st = self._story
        page = max(1, st["vis"] - 2)
        cur = getattr(self, "codex_scroll", 0)
        k = ev.keysym
        if k == "Up":
            self.story_scroll_to(cur - 1)
        elif k == "Down":
            self.story_scroll_to(cur + 1)
        elif k == "Prior":
            self.story_scroll_to(cur - page)
        elif k == "Next":
            self.story_scroll_to(cur + page)
        elif k == "Home":
            self.story_scroll_to(0)
        elif k == "End":
            self.story_scroll_to(10 ** 9)
        else:
            return False
        return True

    def story_thumb_press(self):
        self._sb_drag = dict(y0=self.mouse[1], s0=getattr(self, "codex_scroll", 0))

    def story_track_click(self):
        st = self.__dict__.get("_story")
        if not st:
            return
        mx = st["total"] - st["vis"]
        span = st["track_h"] - st["thumb_h"]
        if mx <= 0 or span <= 0:
            return
        frac = (self.mouse[1] - st["track_y"] - st["thumb_h"] / 2.0) / span
        self.story_scroll_to(round(frac * mx))

    def story_drag(self, ev):
        d = self.__dict__.get("_sb_drag")
        st = self.__dict__.get("_story")
        if not d or not st:
            return
        mx = st["total"] - st["vis"]
        span = st["track_h"] - st["thumb_h"]
        if mx <= 0 or span <= 0:
            return
        y = (ev.y - getattr(self.canvas, "oy", 0.0)) / getattr(self.canvas, "s", 1.0)
        self.story_scroll_to(round(d["s0"] + (y - d["y0"]) / span * mx))

    def on_drag(self, ev):
        if self.__dict__.get("_sb_drag"):
            self.story_drag(ev)
        else:
            self.on_motion(ev)

    def on_release(self, ev):
        self._sb_drag = None

    def render_story_panel(self, data, text, accent, x, y, w, h):
        self.canvas.create_rectangle(x, y, x + w, y + h, fill=PANEL2, outline=BRD, tags="ui")
        self.txt(x + 18, y + 12, "스토리", 15, accent, bold=True)
        self.txt(x + 92, y + 15, data.get("title", ""), 12, MUT, mono=True)
        self.canvas.create_line(x + 18, y + 42, x + w - 18, y + 42, fill=BRD, tags="ui")

        lf = self.font(15)
        sbw = 12
        left, top = x + 24, y + 56
        maxw = w - 48 - sbw - 12
        view_h = h - 56 - 22
        lh = lf.metrics("linespace") + 9
        vis = max(1, int(view_h // lh))
        key = (hash(text), int(maxw))
        cache = self.__dict__.get("_story_wrap")
        if not cache or cache[0] != key:
            cache = (key, self.wrap_story(text, lf, maxw))
            self._story_wrap = cache
        lines = cache[1]
        total = len(lines)
        mx = max(0, total - vis)
        self.codex_scroll = max(0, min(mx, int(getattr(self, "codex_scroll", 0))))
        s0 = self.codex_scroll
        for i, line in enumerate(lines[s0:s0 + vis]):
            if line:
                self.txt(left, top + i * lh, line, 15, TXT)

        track_x, track_y, track_h = x + w - 18 - sbw, top, vis * lh
        thumb_h = track_h
        if mx > 0:
            thumb_h = max(32.0, track_h * vis / float(total))
            thumb_y = track_y + (track_h - thumb_h) * (s0 / float(mx))
            self.canvas.create_rectangle(track_x, track_y, track_x + sbw, track_y + track_h,
                                         fill=PANEL, outline=BRD, tags="ui")
            self.canvas.create_rectangle(track_x + 1, thumb_y, track_x + sbw - 1, thumb_y + thumb_h,
                                         fill=accent, outline="", tags="ui")
            self.buttons.append(dict(x=track_x, y=thumb_y, w=sbw, h=thumb_h, key=("sbt", 0),
                                     cb=self.story_thumb_press))
            self.buttons.append(dict(x=track_x, y=track_y, w=sbw, h=track_h, key=("sbt", 1),
                                     cb=self.story_track_click))
        self._story = dict(total=total, vis=vis, track_y=track_y, track_h=track_h,
                           thumb_h=thumb_h)
        self.txt(x + w - 18, y + 15, "%d–%d / %d줄" % (s0 + 1, min(total, s0 + vis), total),
                 11, MUT, mono=True, anchor="ne")
        if mx > 0:
            self.txt(x + w / 2, y + h - 11, "마우스 휠 · ↑↓ · PageUp/PageDown · 스크롤바 드래그",
                     10, MUT, mono=True, anchor="center")

    def codex_to_char_select(self):
        self.codex_page = "char_select"
        self.render()

    def _load_fit(self, p):
        """이미지를 표시 상자(CHAR_IMG_BOX)에 꽉 차게 맞춘다.
        Pillow 가 있으면 부드럽게 리사이즈하고, 없으면 tk 의 정수 배율(zoom/subsample)로 최대한 맞춘다."""
        box = int(round(CHAR_IMG_BOX * self.canvas.s))
        try:
            from PIL import Image, ImageTk
            im = Image.open(p).convert("RGBA")
            r = box / float(max(im.size))
            resample = getattr(Image, "Resampling", Image).LANCZOS
            im = im.resize((max(1, round(im.width * r)), max(1, round(im.height * r))), resample)
            return ImageTk.PhotoImage(im)
        except Exception:
            pass
        try:
            img = tk.PhotoImage(file=p)
        except tk.TclError:
            return None
        big = max(img.width(), img.height())
        best = (1, max(1, math.ceil(big / float(box))))
        best_size = big / float(best[1])
        for z in (1, 2, 3):
            for s in range(1, 13):
                size = big * z / float(s)
                if best_size < size <= box:
                    best, best_size = (z, s), size
        z, s = best
        if z > 1:
            img = img.zoom(z, z)
        if s > 1:
            img = img.subsample(s, s)
        return img

    def _char_image(self, fname):
        """등장인물 이미지를 불러온다 (표시 상자 418px 안에 맞게 정수 배율로 축소). 없으면 None."""
        cache = self.__dict__.setdefault("_char_img_cache", {})
        key = (fname, int(round(CHAR_IMG_BOX * self.canvas.s)))
        if key in cache:
            return cache[key]
        for _old in [k for k in cache if k[0] == fname]:
            del cache[_old]
        img = None
        base = os.path.dirname(os.path.abspath(__file__))
        for d in (base, os.path.join(base, "images"), os.path.join(base, "assets"), os.getcwd()):
            p = os.path.join(d, fname)
            if os.path.exists(p):
                img = self._load_fit(p)
                break
        cache[key] = img
        return img

    def render_char_select(self):
        self.buttons = []
        self.canvas.create_rectangle(0, 0, WIN_W, WIN_H, fill="#000000", outline="",
                                     stipple="gray75", tags="ui")
        pw, ph = 800, 330
        px, py = (WIN_W - pw) / 2, 250
        self.canvas.create_rectangle(px + 5, py + 5, px + pw + 5, py + ph + 5,
                                     fill="#05070A", outline="", stipple="gray50", tags="ui")
        self.canvas.create_rectangle(px, py, px + pw, py + ph, fill=PANEL, outline=ROSE,
                                     width=2, tags="ui")
        self.canvas.create_rectangle(px, py, px + pw, py + 5, fill=ROSE, outline="", tags="ui")
        self.txt(px + 24, py + 16, "등장인물 도감", 30, TXT, bold=True)
        self.txt(px + 24, py + 62, "열람할 등장인물을 고르세요", 12, MUT, mono=True)
        self.txt(px + pw - 24, py + 24, "[F] 닫기 · [ESC] 서재로", 11, MUT, mono=True, anchor="ne")
        self.canvas.create_line(px + 24, py + 84, px + pw - 24, py + 84, fill=BRD, tags="ui")

        bw, bh, gap = (pw - 48 - 32) / 3, 150, 16
        by = py + 104
        for i, c in enumerate(CHARACTERS):
            bx = px + 24 + i * (bw + gap)
            hov = self.hover == ("chs", i)
            self.canvas.create_rectangle(bx, by, bx + bw, by + bh,
                                         fill=PANEL2 if hov else PANEL, outline=c["color"],
                                         width=3 if hov else 2, tags="ui")
            self.canvas.create_rectangle(bx, by, bx + bw, by + 6, fill=c["color"], outline="",
                                         tags="ui")
            self.txt(bx + bw / 2, by + 52, c["id"], 44, c["color"], bold=True, anchor="center")
            self.txt(bx + bw / 2, by + 98, c["role"], 12, TXT, mono=True, anchor="center")
            has = any(fn for _, fn in c["images"])
            self.txt(bx + bw / 2, by + 124, "컨셉 아트 · 이미지" if has else "준비 중",
                     11, HEAL if has else MUT, mono=True, anchor="center")
            sp = c.get("special")
            if sp:
                sp_lock = sp["aspect"] not in self.owned_aspects
                self.txt(bx + bw / 2, by + 20,
                         "★★★ 특별 일러스트 · " + ("잠김" if sp_lock else "해금"),
                         10, MUT if sp_lock else STAR_COLOR[3], mono=True, anchor="center")
            self.buttons.append(dict(x=bx, y=by, w=bw, h=bh, key=("chs", i),
                                     cb=(lambda cid=c["id"]: self.codex_open_char(cid))))

        bx = px + pw / 2 - 70
        self.canvas.create_rectangle(bx, py + ph - 46, bx + 140, py + ph - 14,
                                     fill=PANEL2 if self.hover == ("chs", -1) else PANEL,
                                     outline=MUT, tags="ui")
        self.txt(bx + 70, py + ph - 30, "← 서재로", 12, MUT, mono=True, anchor="center")
        self.buttons.append(dict(x=bx, y=py + ph - 46, w=140, h=32, key=("chs", -1),
                                 cb=self.codex_back))

    def render_char_page(self):
        self.buttons = []
        self._story = None
        c = next((x for x in CHARACTERS if x["id"] == getattr(self, "codex_char", "N")),
                 CHARACTERS[0])
        special = c.get("special")
        page = getattr(self, "codex_char_page", 0) if special else 0
        sp_aspect = next((a for a in ASPECTS if special and a["id"] == special["aspect"]), None)
        sp_name = sp_aspect["title"] if sp_aspect else "특별"
        sp_locked = bool(special and special["aspect"] not in self.owned_aspects)
        locked = bool(page == 1 and sp_locked)
        data = special if page == 1 else c
        accent = STAR_COLOR[3] if page == 1 else c["color"]
        sc = getattr(self.canvas, "s", 1.0)
        desc_text, story_text = self.char_texts(data, page)
        has_story = bool(story_text.strip()) and not locked
        seen = self.__dict__.setdefault("_special_seen", set())
        if special and page == 1 and not sp_locked:
            seen.add(c["id"])
        show_new = bool(special and not sp_locked and c["id"] not in seen)

        self.canvas.create_rectangle(0, 0, WIN_W, WIN_H, fill="#000000", outline="",
                                     stipple="gray75", tags="ui")
        pw, ph = 1000, 810
        px, py = (WIN_W - pw) / 2, 10
        self.canvas.create_rectangle(px + 5, py + 5, px + pw + 5, py + ph + 5,
                                     fill="#05070A", outline="", stipple="gray50", tags="ui")
        self.canvas.create_rectangle(px, py, px + pw, py + ph, fill=PANEL, outline=accent,
                                     width=2, tags="ui")
        self.canvas.create_rectangle(px, py, px + pw, py + 5, fill=accent, outline="",
                                     tags="ui")
        ix, iw = px + 24, pw - 48
        self.txt(ix, py + 12, c["id"], 32, c["color"], bold=True)
        self.txt(ix + 52, py + 28, c["role"], 14, TXT, mono=True)
        self.canvas.create_line(ix, py + 62, ix + iw, py + 62, fill=BRD, tags="ui")

        # 페이지 전환 — 헤더 오른쪽에 크게
        if special:
            pf = self.font(13, bold=True)
            labels = [("1  기본 프로필", c["color"]),
                      ("2  ★★★ %s 특별 일러스트%s" % (sp_name, "  · 잠김" if sp_locked else ""),
                       STAR_COLOR[3])]
            widths = [pf.measure(lbl) + 32 for lbl, _ in labels]
            bx = ix + iw
            for k in (1, 0):
                lbl, col = labels[k]
                bx -= widths[k]
                on = (k == page)
                lock_k = (k == 1 and sp_locked)
                hov = self.hover == ("chp", k)
                self.canvas.create_rectangle(bx, py + 12, bx + widths[k], py + 46,
                                             fill=col if on else (PANEL2 if hov else PANEL),
                                             outline=MUT if lock_k else col,
                                             width=3 if (on or hov) else 2, tags="ui")
                self.txt(bx + widths[k] / 2, py + 29, lbl, 13,
                         "#101318" if on else (MUT if lock_k else TXT),
                         bold=True, anchor="center")
                if k == 1 and show_new and not on:
                    self.canvas.create_rectangle(bx + widths[k] - 40, py + 3, bx + widths[k] - 2,
                                                 py + 20, fill=DMG, outline="", tags="ui")
                    self.txt(bx + widths[k] - 21, py + 11, "NEW", 10, "#FFFFFF", mono=True,
                             bold=True, anchor="center")
                self.buttons.append(dict(x=bx, y=py + 12, w=widths[k], h=34, key=("chp", k),
                                         cb=(lambda p=k: self.codex_set_char_page(p))))
                bx -= 8
            self.txt(bx + 2, py + 29, "페이지 ▶", 11, MUT, mono=True, anchor="e")
            self.txt(ix + iw, py + 49, "← → 키로도 전환할 수 있다", 10, MUT, mono=True, anchor="ne")

        box = CHAR_IMG_BOX
        ty = py + 70

        images = data["images"]
        tabs = list(images) + ([("스토리", None)] if has_story else [])
        tab = max(0, min(getattr(self, "codex_img_tab", 0), len(tabs) - 1))
        story_tab = bool(has_story and tab == len(images))

        # 이미지/스토리 탭 (잠겨 있으면 숨긴다)
        if not locked:
            tx = ix
            for k, (tab_label, _fn) in enumerate(tabs):
                tw = 150
                on = (k == tab)
                hov = self.hover == ("cht", k)
                self.canvas.create_rectangle(tx, ty, tx + tw, ty + 32,
                                             fill=accent if on else (PANEL2 if hov else PANEL),
                                             outline=accent, width=2, tags="ui")
                self.txt(tx + tw / 2, ty + 16, tab_label, 13, "#101318" if on else TXT,
                         bold=on, anchor="center")
                self.buttons.append(dict(x=tx, y=ty, w=tw, h=32, key=("cht", k),
                                         cb=(lambda i=k: self.codex_set_tab(i))))
                tx += tw + 8

        iy = ty + 40
        if story_tab:
            self.render_story_panel(data, story_text, accent, ix, iy, iw, box)
        else:
            # 큰 이미지 (왼쪽)
            if locked:
                cx, cy = ix + box / 2, iy + box / 2
                self.canvas.create_rectangle(ix, iy, ix + box, iy + box, fill="#161A20",
                                             outline=MUT, width=2, dash=(8, 6), tags="ui")
                self.txt(cx, cy - 56, "잠김", 46, MUT, bold=True, anchor="center")
                self.txt(cx, cy + 4, "%s 형상을 획득하면 열린다" % sp_name, 16, TXT, anchor="center")
                self.wtxt(cx, cy + 40, box - 60,
                          "형상해석 ★★★ 1%%  ·  형상파편 %d개로 선택 교환" % GACHA_PITY_TIER3,
                          12, MUT, mono=True, anchor="n", justify="center")
            else:
                label, fname = images[tab]
                img = self._char_image(fname) if fname else None
                self.canvas.create_rectangle(ix - 1, iy - 1, ix + box + 1, iy + box + 1,
                                             fill="#FFFFFF" if img else PANEL2,
                                             outline=accent if img else BRD, tags="ui")
                if img:
                    self.canvas.create_image(ix + (box - img.width() / sc) / 2,
                                             iy + (box - img.height() / sc) / 2,
                                             image=img, anchor="nw", tags="ui")
                else:
                    if fname:
                        msg = ("이미지 파일을 찾을 수 없다\n%s\nNHC.py 와 같은 폴더(또는 images 폴더)에 "
                               "넣어주세요." % fname)
                    else:
                        msg = "준비 중"
                    self.wtxt(ix + box / 2, iy + box / 2, box - 40, msg, 13, MUT, mono=True,
                              anchor="center", justify="center")

            # 설명 (오른쪽)
            dx = ix + box + 20
            dw = iw - box - 20
            self.canvas.create_rectangle(dx, ty, dx + dw, iy + box, fill=PANEL2, outline=BRD,
                                         tags="ui")
            box_title = "프로필" if page == 0 else data["title"]
            self.txt(dx + 14, ty + 12, box_title, 14, accent, bold=True)
            self.canvas.create_line(dx + 14, ty + 40, dx + dw - 14, ty + 40, fill=BRD, tags="ui")
            if locked:
                desc = ("잠겨 있다.\n\n형상해석(E 키)에서 %s 형상을 획득하면 이 페이지가 열린다.\n\n"
                        "획득 확률은 ★★★ 1%%이며, 형상파편 %d개로 선택 교환도 할 수 있다."
                        % (sp_name, GACHA_PITY_TIER3))
            else:
                desc = desc_text
                if has_story:
                    desc += "\n\n▶ '스토리' 탭에서 이어서 읽을 수 있다."
            self.wtxt(dx + 14, ty + 54, dw - 28, desc, 13, MUT if locked else TXT)

            # 페이지 이동 큰 버튼 (설명 칸 아래)
            if special:
                cb_y = iy + box - 56
                if page == 0:
                    lbl = "★★★ %s 특별 일러스트 보러 가기 ▶" % sp_name + ("\n(잠김)" if sp_locked else "")
                    col, target = STAR_COLOR[3], 1
                    dim = sp_locked
                else:
                    lbl = "◀ 1페이지 · 기본 프로필로 돌아가기"
                    col, target = c["color"], 0
                    dim = False
                hov = self.hover == ("chg", 0)
                self.canvas.create_rectangle(dx + 14, cb_y, dx + dw - 14, cb_y + 44,
                                             fill=PANEL2 if hov else PANEL,
                                             outline=MUT if dim else col, width=2, tags="ui")
                self.wtxt(dx + dw / 2, cb_y + 22, dw - 48, lbl, 12, MUT if dim else col,
                          anchor="center", bold=True, justify="center")
                self.buttons.append(dict(x=dx + 14, y=cb_y, w=dw - 28, h=44, key=("chg", 0),
                                         cb=(lambda p=target: self.codex_set_char_page(p))))

        bx = px + pw / 2 - 70
        self.canvas.create_rectangle(bx, py + ph - 46, bx + 140, py + ph - 14,
                                     fill=PANEL2 if self.hover == ("chr", -1) else PANEL,
                                     outline=MUT, tags="ui")
        self.txt(bx + 70, py + ph - 30, "← 목록으로", 12, MUT, mono=True, anchor="center")
        self.buttons.append(dict(x=bx, y=py + ph - 46, w=140, h=32, key=("chr", -1),
                                 cb=self.codex_to_char_select))
        self.txt(px + pw - 24, py + ph - 30, "[F] 닫기 · [ESC] 목록으로", 11, MUT, mono=True,
                 anchor="e")

    def render_effect_codex(self):
        if not self.codex_open:
            return
        self.buttons = []     # 뒤쪽 버튼이 눌리지 않도록 교체
        self.canvas.create_rectangle(0, 0, WIN_W, WIN_H, fill="#000000", outline="",
                                     stipple="gray75", tags="ui")
        pw, ph = 900, 640
        px, py = (WIN_W - pw) / 2, 60
        self.canvas.create_rectangle(px + 5, py + 5, px + pw + 5, py + ph + 5,
                                     fill="#05070A", outline="", stipple="gray50", tags="ui")
        self.canvas.create_rectangle(px, py, px + pw, py + ph, fill=PANEL, outline=BRKC,
                                     width=2, tags="ui")
        self.canvas.create_rectangle(px, py, px + pw, py + 5, fill=BRKC, outline="", tags="ui")
        ix, iw = px + 24, pw - 48

        self.txt(ix, py + 14, "전투효과 도감", 28, TXT, bold=True)
        self.txt(ix + 214, py + 28, "마우스를 올리면 설명 · 클릭하면 아래에 고정", 12, MUT, mono=True)
        self.txt(px + pw - 24, py + 24, "[F] 닫기 · [ESC] 서재로", 11, MUT, mono=True, anchor="ne")
        self.canvas.create_line(ix, py + 60, ix + iw, py + 60, fill=BRD, tags="ui")

        per_row, gap, chip_h = 5, 8, 46
        cw = (iw - (per_row - 1) * gap) / per_row
        y = py + 72
        for cat_id, cat_label, cat_color in EFFECT_CATS:
            items = [(i, e) for i, e in enumerate(EFFECTS) if e["cat"] == cat_id]
            self.txt(ix, y, "%s  (%d)" % (cat_label, len(items)), 13, cat_color, bold=True)
            y += 24
            for n, (idx, e) in enumerate(items):
                cx = ix + (n % per_row) * (cw + gap)
                cy = y + (n // per_row) * (chip_h + gap)
                hov = self.hover == ("cdx", idx)
                sel = self.codex_sel == idx
                holders = self.effect_holders(e["id"])
                self.canvas.create_rectangle(cx, cy, cx + cw, cy + chip_h,
                                             fill=PANEL2 if (hov or sel) else PANEL,
                                             outline=e["color"],
                                             width=3 if sel else (2 if hov else 1), tags="ui")
                self.txt(cx + cw / 2, cy + 15, e["name"], 14, e["color"], bold=True,
                         anchor="center")
                if holders:
                    self.txt(cx + cw / 2, cy + 34, "● 적용 중 %d" % len(holders), 10, HEAL,
                             mono=True, anchor="center")
                else:
                    sub = e["scope"]
                    sf = self.font(10, mono=True)
                    if sf.measure(sub) > cw - 12:
                        while sub and sf.measure(sub + "…") > cw - 12:
                            sub = sub[:-1]
                        sub += "…"
                    self.txt(cx + cw / 2, cy + 34, sub, 10, MUT, mono=True, anchor="center")
                self.buttons.append(dict(x=cx, y=cy, w=cw, h=chip_h, key=("cdx", idx),
                                         cb=(lambda k=idx: self.select_effect(k))))
            rows = (len(items) + per_row - 1) // per_row
            y += rows * (chip_h + gap) + 8

        # 고정된 상세 설명
        dy = py + ph - 138
        dh = 86
        self.canvas.create_rectangle(ix, dy, ix + iw, dy + dh, fill=PANEL2, outline=BRD, tags="ui")
        if self.codex_sel is not None and self.codex_sel < len(EFFECTS):
            e = EFFECTS[self.codex_sel]
            self.txt(ix + 14, dy + 8, e["name"], 16, e["color"], bold=True)
            self.txt(ix + iw - 14, dy + 12, e["scope"], 11, MUT, mono=True, anchor="ne")
            self.wtxt(ix + 14, dy + 32, iw - 28, e["desc"].replace(" / ", "\n"), 11, TXT, mono=True)
        else:
            self.txt(ix + iw / 2, dy + dh / 2, "효과를 클릭하면 여기에 설명이 고정된다.", 12, MUT,
                     mono=True, anchor="center")

        bx = px + pw / 2 - 70
        self.canvas.create_rectangle(bx, py + ph - 40, bx + 140, py + ph - 8,
                                     fill=PANEL2 if self.hover == ("cdx", -1) else PANEL,
                                     outline=MUT, tags="ui")
        self.txt(bx + 70, py + ph - 24, "← 서재로", 12, MUT, mono=True, anchor="center")
        self.buttons.append(dict(x=bx, y=py + ph - 40, w=140, h=32, key=("cdx", -1),
                                 cb=self.codex_back))

        h = self.hover
        if isinstance(h, tuple) and h[0] == "cdx" and 0 <= h[1] < len(EFFECTS):
            self.draw_effect_tip(EFFECTS[h[1]])

    # ---------------- 입력 ----------------
    # ================================================================
    # 로비 — 게임을 켜면 가장 먼저 나오는 허브. 워프 게이트로 전투 / 제작소 / 형상 / 서재로 이동한다.
    # ================================================================
    def apply_equipped_all(self):
        """로비에서 장착해 둔 형상을 새 전투의 아군에게 적용한다."""
        eq = self.__dict__.get("equipped") or {}
        owned = self.__dict__.get("owned_aspects") or ()
        for cid, unit in self.units.items():
            if unit.side != "ally":
                continue
            aid = eq.get(cid)
            asp = next((a for a in ASPECTS if a["id"] == aid), None)
            if not asp or aid not in owned:
                continue
            unit.aspect_id = aid
            unit.skills = asp["skills"]
            unit.max_sp = 10 if aid == "n_imperial" else MAX_SP

    def go_lobby(self):
        """전투를 마치고 로비로 돌아간다. (형상·조각·형상파편은 유지, 전투 진행도는 초기화)"""
        self._enter = time.monotonic()
        self.new_game(to_lobby=True)

    def lobby_start_battle(self):
        self.new_game()

    def lobby_workshop(self):
        self.codex_open = True
        self.codex_page = "workshop"
        self.render()

    def lobby_aspect(self):
        self.gacha_open = True
        self.render()

    def lobby_library(self):
        self.codex_open = True
        self.codex_page = "menu"
        self.codex_sel = None
        self.render()

    def open_aspect_codex(self):
        """형상해석 창에서 바로 형상 도감(장착 화면)으로 넘어간다."""
        self.close_gacha()
        self.codex_open = True
        self.codex_page = "aspect"
        self.codex_sel = None
        self.render()

    def lobby_emblem(self, gid, cx, cy, col):
        cv = self.canvas
        if gid == "battle":
            cv.create_line(cx - 26, cy - 26, cx + 26, cy + 26, fill=col, width=5,
                           capstyle="round", tags="ui")
            cv.create_line(cx + 26, cy - 26, cx - 26, cy + 26, fill=col, width=5,
                           capstyle="round", tags="ui")
            cv.create_oval(cx - 9, cy - 9, cx + 9, cy + 9, outline=col, width=3, tags="ui")
        elif gid == "workshop":
            pts = []
            for k in range(6):
                a = math.pi / 3 * k + math.pi / 6
                pts += [cx + math.cos(a) * 32, cy + math.sin(a) * 32]
            cv.create_polygon(*pts, fill="", outline=col, width=4, tags="ui")
            cv.create_oval(cx - 11, cy - 11, cx + 11, cy + 11, outline=col, width=4, tags="ui")
        elif gid == "aspect":
            pts = []
            for k in range(10):
                a = -math.pi / 2 + math.pi * k / 5
                r = 36 if k % 2 == 0 else 15
                pts += [cx + math.cos(a) * r, cy + math.sin(a) * r]
            cv.create_polygon(*pts, fill="", outline=col, width=3, tags="ui")
        else:
            cv.create_rectangle(cx - 36, cy - 24, cx - 2, cy + 26, outline=col, width=3, tags="ui")
            cv.create_rectangle(cx + 2, cy - 24, cx + 36, cy + 26, outline=col, width=3, tags="ui")
            for k in range(3):
                cv.create_line(cx - 28, cy - 8 + k * 11, cx - 10, cy - 8 + k * 11,
                               fill=col, tags="ui")
                cv.create_line(cx + 10, cy - 8 + k * 11, cx + 28, cy - 8 + k * 11,
                               fill=col, tags="ui")

    # ---------------- 타이틀 / 로비 (로비 패치) ----------------
    def _now(self):
        if self._t0 is None:
            self._t0 = time.monotonic()
        return time.monotonic() - self._t0

    def _fc(self, col, a):
        """공허 배경에서 col 쪽으로 a(0~1)만큼 섞은 색 — 알파 대용."""
        return lerp_color(LB_BG, col, max(0.0, min(1.0, a)))

    def _stars_data(self):
        if "_stars" not in self.__dict__:
            rnd = random.Random(7)
            cols = ["#FFFFFF", "#CFC4FF", "#FFC2E2", "#9CC4FF"]
            self._stars = [(rnd.uniform(0, WIN_W), rnd.uniform(0, WIN_H),
                            rnd.choice([1, 1, 1.4, 2, 2.6]), rnd.uniform(1.5, 7),
                            rnd.uniform(0, 6.28), rnd.uniform(0.6, 2.2), rnd.choice(cols))
                           for _ in range(95)]
        return self._stars

    def _draw_void(self, t, a=1.0):
        cv = self.canvas
        try:
            cv.configure(bg=LB_BG)
        except tk.TclError:
            pass
        cx, cy = WIN_W / 2, 430
        steps = 9
        breath = 0.9 + 0.1 * math.sin(t * 0.5)
        for k in range(steps):                       # 성운
            r = 470 - k * 48
            col = lerp_color(LB_BG, LB_NEBULA, (k + 1) / steps * 0.85 * breath)
            cv.create_oval(cx - r, cy - r * 0.8, cx + r, cy + r * 0.8,
                           fill=self._fc(col, a), outline="", tags="ui")
        for r, sp in ((300, 8), (400, -5), (500, 3)):    # 굴레 — 느리게 도는 점선 고리
            cv.create_oval(cx - r, cy - r * 0.8, cx + r, cy + r * 0.8,
                           outline=self._fc(LB_RING, a * 0.55), width=2, dash=(2, 14),
                           dashoffset=int((t * sp) % 16), tags="ui")
        for sx, sy, r, drift, ph, tws, col in self._stars_data():   # 별
            y = (sy + t * drift) % WIN_H
            x = sx + math.sin(t * 0.3 + ph) * 6
            tw = 0.5 + 0.5 * math.sin(t * tws + ph * 6)
            c = self._fc(col, a * (0.25 + 0.75 * tw))
            if r > 1.8:
                L = r * 3.2
                cv.create_line(x - L, y, x + L, y, fill=c, tags="ui")
                cv.create_line(x, y - L, x, y + L, fill=c, tags="ui")
            cv.create_oval(x - r, y - r, x + r, y + r, fill=c, outline="", tags="ui")

    def _glitch_text(self, x, y, text, size, col, t, a=1.0, bold=True, mono=False):
        if int(t * 9) % 41 == 0:   # 가끔 색이 갈라지는 글리치
            self.txt(x - 4, y, text, size, self._fc(ROSE, a * 0.8), mono=mono,
                     anchor="center", bold=bold)
            self.txt(x + 4, y + 1, text, size, self._fc(BLUE_H, a * 0.8), mono=mono,
                     anchor="center", bold=bold)
        self.txt(x, y, text, size, self._fc(col, a), mono=mono, anchor="center", bold=bold)

    def title_play(self):
        self.title_screen = False
        self._enter = time.monotonic()
        beep([(523, 70), (784, 80), (1046, 140)], self.sound)
        self.render()

    def toggle_workshop(self):
        """전투 중 Z — 제작소 창 열기/닫기."""
        if self.codex_open and self.codex_page == "workshop":
            self.close_codex()
            return
        if (self.codex_open or self.admin or self.admin_kill_pending or self.modal
                or self.gacha_open or self.state == "augment_pick"):
            return
        self.codex_open = True
        self.codex_page = "workshop"
        self.codex_sel = None
        self.render()

    def render_title(self):
        t = self._now()
        cx = WIN_W / 2
        self._draw_void(t)
        for k in range(5, 0, -1):                    # 로고 후광
            r = 60 + k * 34 + 6 * math.sin(t * 1.2)
            self.canvas.create_oval(cx - r * 2.2, 300 - r * 0.9, cx + r * 2.2, 300 + r * 0.9,
                                    outline=self._fc("#4B3A92", 0.10 + 0.05 * (6 - k)),
                                    width=2, tags="ui")
        self.txt(cx, 190, "P R O J E C T", 22, self._fc("#9C8FEC", 1), mono=True, anchor="center")
        self._glitch_text(cx, 300, "NHC", 130, TXT, t)
        self.canvas.create_line(cx - 230, 392, cx + 230, 392,
                                fill=self._fc(LB_LINE, 0.55), tags="ui")

        bw, bh = 260, 62
        bx, by = cx - bw / 2, 520
        hov = self.hover == ("title", 0)
        pulse = 0.5 + 0.5 * math.sin(t * 2.2)
        col = STAR_COLOR[3]
        glow = 0.45 + 0.35 * pulse + (0.2 if hov else 0)
        self.canvas.create_rectangle(bx - 8, by - 8, bx + bw + 8, by + bh + 8,
                                     outline=self._fc(col, glow * 0.5), tags="ui")
        self.canvas.create_rectangle(bx, by, bx + bw, by + bh,
                                     fill=self._fc(col, 0.22 if hov else 0.08),
                                     outline=self._fc(col, min(1.0, glow + 0.3)),
                                     width=3 if hov else 2, tags="ui")
        self.txt(cx, by + bh / 2, "▶  PLAY", 30, self._fc("#FFFFFF" if hov else col, 1),
                 bold=True, anchor="center")
        self.buttons.append(dict(x=bx, y=by, w=bw, h=bh, key=("title", 0), cb=self.title_play))
        if int(t * 1.6) % 2 == 0:
            self.txt(cx, 612, "PRESS ENTER", 12, MUT, mono=True, anchor="center")

    def render_lobby(self):
        if self.title_screen:
            self.render_title()
            return

        t = self._now()
        a = min(1.0, (time.monotonic() - self._enter) / 1.4) if self._enter else 1.0
        cv = self.canvas
        self._draw_void(t, a)

        # 헤더
        self.txt(MARGIN, 24, "NHC", 30, TXT, bold=True, anchor="w")
        logo_w = self.font(30, bold=True).measure("NHC")
        self.txt(MARGIN + logo_w + 12, 27, "LOBBY", 16, MUT, mono=True, anchor="w")
        self.txt(WIN_W - MARGIN, 10, "조각 %d   형상파편 %d" % (self.aspect_shards, self.aspect_pity),
                 13, SPC, mono=True, anchor="ne")
        self.hbtn(WIN_W - MARGIN, 32, None, 24, "게임 종료", self.root.destroy, MUT, anchor="ne")
        cv.create_line(MARGIN, 62, WIN_W - MARGIN, 62, fill=self._fc(BRD, a), width=2, tags="ui")

        # 별자리 선 + 흐르는 빛
        for n, (i, j) in enumerate(LOBBY_EDGES):
            x0, y0 = LOBBY_NODES[i][4], LOBBY_NODES[i][5]
            x1, y1 = LOBBY_NODES[j][4], LOBBY_NODES[j][5]
            cv.create_line(x0, y0, x1, y1, fill=self._fc(LB_LINE, a * 0.38), dash=(4, 8),
                           dashoffset=int((t * 14) % 12), tags="ui")
            p = (t * 0.22 + n * 0.31) % 1.0
            px, py = x0 + (x1 - x0) * p, y0 + (y1 - y0) * p
            cv.create_oval(px - 4, py - 4, px + 4, py + 4, fill=self._fc("#FFFFFF", a * 0.85),
                           outline="", tags="ui")
        cv.create_line(LOBBY_NODES[0][4], LOBBY_NODES[0][5], WIN_W / 2, 105,
                       LOBBY_NODES[1][4], LOBBY_NODES[1][5],
                       smooth=True, fill=self._fc(LB_LINE, a * 0.25), dash=(3, 9), tags="ui")

        # 노드
        for i, (gid, name, sub, col, cx, cy, rx, ry, cbname) in enumerate(LOBBY_NODES):
            hov = self.hover == ("gate", i)
            d = 1 if i % 2 == 0 else -1
            cy = cy + math.sin(t * 0.9 + i * 1.7) * 4        # 둥둥 떠 있는 느낌
            boost = 1.7 if hov else 1.0

            for k in range(4, 0, -1):                        # 바깥 후광
                e = k * 9 + (6 if hov else 0)
                cv.create_oval(cx - rx - e, cy - ry - e * 0.8, cx + rx + e, cy + ry + e * 0.8,
                               outline=self._fc(col, a * (0.10 + 0.05 * (5 - k)) * boost),
                               width=2, tags="ui")
            cv.create_oval(cx - rx, cy - ry, cx + rx, cy + ry,
                           fill=self._fc(col, a * (0.24 if hov else 0.10)),
                           outline=self._fc(col, a * (1.0 if hov else 0.75)),
                           width=4 if hov else 3, tags="ui")
            cv.create_oval(cx - rx + 12, cy - ry + 10, cx + rx - 12, cy + ry - 10,
                           outline=self._fc(col, a * 0.5), width=2, dash=(10, 8),
                           dashoffset=int((t * 30 * d) % 18), tags="ui")
            q = (t * 0.6 + i * 0.27) % 1.0                   # 퍼지는 맥동 링
            cv.create_oval(cx - rx - 40 * q, cy - ry - 32 * q, cx + rx + 40 * q, cy + ry + 32 * q,
                           outline=self._fc(col, a * (1 - q) * 0.45), tags="ui")
            for k in range(5):                               # 궤도 입자
                ang = t * 0.8 * d + k * math.tau / 5
                ox = cx + math.cos(ang) * (rx + 16)
                oy = cy + math.sin(ang) * (ry + 14)
                cv.create_oval(ox - 3, oy - 3, ox + 3, oy + 3, fill=self._fc(col, a * 0.8),
                               outline="", tags="ui")

            size = 34 if rx > 150 else 30
            self.txt(cx, cy - 8 if sub else cy, name, size, self._fc(col if hov else TXT, a),
                     bold=True, anchor="center")
            self.txt(cx, cy + 24, sub, 12, self._fc(TXT if hov else MUT, a),
                     mono=True, anchor="center")
            if hov:
                self.txt(cx, cy + ry + 24, "▶ 클릭해서 이동", 11, self._fc(col, a),
                         mono=True, anchor="center")
            self.buttons.append(dict(x=cx - rx - 10, y=cy - ry - 10, w=rx * 2 + 20, h=ry * 2 + 20,
                                     key=("gate", i),
                                     cb=(lambda n=cbname: getattr(self, n)())))

        self.txt(WIN_W / 2, WIN_H - 18, "[E] 형상해석   ·   [F] 서재", 11,
                 self._fc(MUT, a), mono=True, anchor="center")

    # ================================================================
    # 아이템 / 인벤토리 (인벤토리 패치)
    # ================================================================
    def add_item(self, item_id, n=1):
        inv = self.__dict__.setdefault("inventory", {})
        inv[item_id] = inv.get(item_id, 0) + n
        return inv[item_id]

    def drop_loot(self, target, queued):
        """적 처치 드랍.
        PHASE 1~2: 빛바랜 소망 1~3개 / PHASE 3~4: 희미한 소망 1~3개 /
        PHASE 3 이후: 빛바랜 소망 50% 확률로 4~6개 추가."""
        drops = []
        if self.phase in LOOT_PHASES:
            drops.append(("faded_wish", random.randint(*LOOT_RANGE)))
        elif self.phase in DIM_LOOT_PHASES:
            drops.append(("dim_wish", random.randint(*LOOT_RANGE)))
        if self.phase > max(LOOT_PHASES) and random.random() < LATE_FADED_CHANCE:
            drops.append(("faded_wish", random.randint(*LATE_FADED_RANGE)))
        dy = -48
        for iid, n in drops:
            total = self.add_item(iid, n)
            item = ITEMS[iid]
            col = ITEM_TIER_COLOR[item["tier"]]
            queued.append(("적 처치 보상: %s +%d (보유 %d개)" % (item["name"], n, total), col))
            self.fx_number(target.id, "+%d %s" % (n, item["name"]), col, 15, dy=dy)
            dy -= 18

    def toggle_inventory(self):
        if self.inv_open:
            self.close_inventory()
            return
        if (getattr(self, "title_screen", False) or self.modal or self.admin
                or self.admin_kill_pending or self.gacha_open or self.codex_open
                or self.state == "augment_pick"):
            return
        self.inv_open = True
        self.inv_sel = 0
        self.render()

    def close_inventory(self):
        self.inv_open = False
        self.render()

    def inv_select(self, k):
        self.inv_sel = k
        self.render()

    def _inv_wrap(self, text, font, maxw):
        out = []
        for para in text.split("\n"):
            cur = ""
            for ch in para:
                if cur and font.measure(cur + ch) > maxw:
                    cut = cur.rfind(" ")
                    if cut > len(cur) * 0.6:
                        out.append(cur[:cut])
                        cur = cur[cut + 1:]
                    else:
                        out.append(cur)
                        cur = ""
                cur += ch
            out.append(cur)
        return out

    def draw_item_icon(self, cx, cy, size, item):
        """빛이 나지 않는, 가루처럼 부서진 별 모양 아이콘."""
        if item.get("icon") == "mirror":
            self.draw_mirror_icon(cx, cy, size, item)
            return
        if item.get("icon") == "umbrella":
            self.draw_umbrella_icon(cx, cy, size, item)
            return
        if item.get("icon") == "cloak":
            self.draw_cloak_icon(cx, cy, size, item)
            return
        cv = self.canvas
        col = ITEM_TIER_COLOR.get(item["tier"], MUT)
        dim = lerp_color(PANEL, col, 0.55)
        r = size * 0.36
        pts = []
        for k in range(10):
            a = -math.pi / 2 + math.pi * k / 5
            rr = r if k % 2 == 0 else r * 0.45
            pts.extend((cx + math.cos(a) * rr, cy + math.sin(a) * rr))
        cv.create_polygon(*pts, fill="", outline=dim, width=2, tags="ui")
        rnd = random.Random(sum(ord(c) for c in item["name"]))
        for _ in range(14):                       # 흩어진 가루
            a = rnd.random() * math.tau
            d = rnd.uniform(0.1, 0.5) * size
            s = rnd.uniform(0.8, 2.3) * (size / 70.0)
            px, py = cx + math.cos(a) * d, cy + math.sin(a) * d
            cv.create_oval(px - s, py - s, px + s, py + s,
                           fill=lerp_color(PANEL, col, rnd.uniform(0.3, 0.7)),
                           outline="", tags="ui")

    def render_inventory(self):
        if not self.inv_open:
            return
        self.buttons = []     # 뒤쪽 버튼이 눌리지 않도록 교체
        cv = self.canvas
        cv.create_rectangle(0, 0, WIN_W, WIN_H, fill="#000000", outline="",
                            stipple="gray75", tags="ui")
        pw, ph = 860, 520
        px, py = (WIN_W - pw) / 2, 150
        accent = ITEM_TIER_COLOR[1]
        cv.create_rectangle(px + 5, py + 5, px + pw + 5, py + ph + 5,
                            fill="#05070A", outline="", stipple="gray50", tags="ui")
        cv.create_rectangle(px, py, px + pw, py + ph, fill=PANEL, outline=accent,
                            width=2, tags="ui")
        cv.create_rectangle(px, py, px + pw, py + 5, fill=accent, outline="", tags="ui")
        self.txt(px + 24, py + 16, "인벤토리", 28, TXT, bold=True)
        self.txt(px + pw - 24, py + 26, "[TAB] / [ESC] 닫기", 11, MUT, mono=True, anchor="ne")
        cv.create_line(px + 24, py + 62, px + pw - 24, py + 62, fill=BRD, tags="ui")

        inv = self.__dict__.get("inventory", {})
        owned = [i for i in ITEM_ORDER if inv.get(i, 0) > 0]
        self.txt(px + 24, py + 70, "소지품 %d종" % len(owned), 11, MUT, mono=True)

        cols, rows, sz, gap = 5, 4, 76, 10
        gx, gy = px + 24, py + 92
        for n in range(cols * rows):
            sx = gx + (n % cols) * (sz + gap)
            sy = gy + (n // cols) * (sz + gap)
            if n < len(owned):
                it = ITEMS[owned[n]]
                hov = self.hover == ("inv", n)
                sel = self.inv_sel == n
                tc = ITEM_TIER_COLOR.get(it["tier"], MUT)
                cv.create_rectangle(sx, sy, sx + sz, sy + sz,
                                    fill=PANEL2 if (hov or sel) else PANEL,
                                    outline=SPC if sel else tc, width=3 if sel else (2 if hov else 1),
                                    tags="ui")
                self.draw_item_icon(sx + sz / 2, sy + sz / 2 - 4, sz, it)
                self.txt(sx + sz - 6, sy + sz - 5, "x%d" % inv[owned[n]], 12, TXT, mono=True,
                         bold=True, anchor="se")
                self.buttons.append(dict(x=sx, y=sy, w=sz, h=sz, key=("inv", n),
                                         cb=(lambda k=n: self.inv_select(k))))
            else:
                cv.create_rectangle(sx, sy, sx + sz, sy + sz, fill="#14181E", outline=BRD,
                                    tags="ui")

        # 상세 정보 (호버 중인 슬롯 → 없으면 클릭해 고정한 슬롯)
        dx = gx + cols * (sz + gap) + 4
        dw = px + pw - 24 - dx
        dy, dh = gy, rows * (sz + gap) - gap
        cv.create_rectangle(dx, dy, dx + dw, dy + dh, fill=PANEL2, outline=BRD, tags="ui")
        di = self.hover[1] if (isinstance(self.hover, tuple) and self.hover[0] == "inv") \
            else self.inv_sel
        if not owned:
            self.txt(dx + dw / 2, dy + dh / 2, "보유한 아이템이 없다.", 13, MUT, anchor="center")
        else:
            di = max(0, min(di, len(owned) - 1))
            iid = owned[di]
            it = ITEMS[iid]
            tc = ITEM_TIER_COLOR.get(it["tier"], MUT)
            self.draw_item_icon(dx + 46, dy + 50, 76, it)
            nf = self.font(20, bold=True)
            self.txt(dx + 92, dy + 22, it["name"], 20, TXT, bold=True)
            self.txt(dx + 92 + nf.measure(it["name"]) + 10, dy + 28, "[%d T]" % it["tier"], 14,
                     tc, mono=True, bold=True)
            self.txt(dx + 92, dy + 56, "보유 %d개" % inv[iid], 12, MUT, mono=True)
            cv.create_line(dx + 16, dy + 98, dx + dw - 16, dy + 98, fill=BRD, tags="ui")
            ty = dy + 112
            df = self.font(14)
            for line in self._inv_wrap(it["desc"], df, dw - 32):
                self.txt(dx + 16, ty, line, 14, TXT)
                ty += df.metrics("linespace") + 4
            ty += 14
            ff = self.font(13)
            for line in self._inv_wrap(it["flavor"], ff, dw - 32):
                self.txt(dx + 16, ty, line, 13, MUT)
                ty += ff.metrics("linespace") + 4

        self.hbtn(px + pw / 2 - 70, py + ph - 46, 140, 32, "닫기 (TAB)", self.close_inventory, MUT)

    # ================================================================
    # 제작소 (제작소 패치) — 떠다니는 비석 + 옆에 뜨는 제작 UI
    # ================================================================
    def workshop_toggle_ui(self):
        self._ws_ui = not self.__dict__.get("_ws_ui", True)
        self._ws_ui_since = time.monotonic()
        self.render()

    def workshop_craft(self, rid):
        rec = next((r for r in WORKSHOP_RECIPES if r["id"] == rid), None)
        if not rec:
            return
        inv = self.__dict__.setdefault("inventory", {})
        if rec.get("max") and inv.get(rid, 0) >= rec["max"]:
            self.ws_notice = "더 이상 제작할 수 없다. (최대 %d개)" % rec["max"]
            self.render()
            return
        if any(inv.get(k, 0) < v for k, v in rec["cost"].items()):
            self.ws_notice = "재료가 부족하다."
            self.render()
            return
        for k, v in rec["cost"].items():
            inv[k] -= v
        total = self.add_item(rid, 1)
        item = ITEMS[rid]
        if rid == "worn_cloak":
            for u in self.allies():
                u.max_brk += 50
                if u.alive and not u.broken:
                    u.brk = min(u.max_brk, u.brk + 50)
            self.log("낡은 망토가 몸을 감싼다 — 모든 아군 최대 격파체력 +50.", BRKC)
        if rid == "torn_umbrella":
            self.log("헤진 우산이 펼쳐진다 — 모든 아군 공격력 +5.", DMG)
        if rid == "small_mirror":
            for u in self.allies():
                u.max_hp += 50
                if u.alive:
                    u.hp = min(u.max_hp, u.hp + 50)
            self.log("작은 거울의 기운이 번진다 — 모든 아군 최대 체력 +50.", HEAL)
        self.ws_notice = "[%s] 제작 완료!  (보유 %d개) · 인벤토리(TAB)에서 확인" % (item["name"], total)
        self._ws_flash = time.monotonic()
        self.log("제작소: [%s] 제작 완료. (보유 %d개)" % (item["name"], total),
                 ITEM_TIER_COLOR.get(item["tier"], MUT))
        beep([(660, 50), (880, 60), (1320, 120)], self.sound)
        self.render()

    def draw_mirror_icon(self, cx, cy, size, item):
        """휴대용 콤팩트 거울 — 둥근 케이스, 거울면, 힌지와 여는 홈."""
        cv = self.canvas
        col = ITEM_TIER_COLOR.get(item["tier"], MUT)
        r = size * 0.32
        case = lerp_color(PANEL, col, 0.45)
        rim = lerp_color(PANEL, col, 0.95)
        lw = max(2, size / 28)
        cv.create_rectangle(cx - r * 0.3, cy - r - size * 0.07, cx + r * 0.3, cy - r + 2,
                            fill=rim, outline="", tags="ui")               # 힌지
        cv.create_oval(cx - r - 4, cy - r - 4, cx + r + 4, cy + r + 4,
                       fill=case, outline=rim, width=lw, tags="ui")        # 케이스
        cv.create_oval(cx - r + 3, cy - r + 3, cx + r - 3, cy + r - 3,
                       fill=lerp_color(PANEL, "#7FC8F8", 0.35),
                       outline=lerp_color(PANEL, col, 0.7), width=lw, tags="ui")  # 거울면
        cv.create_rectangle(cx - r * 0.22, cy + r + 1, cx + r * 0.22, cy + r + size * 0.06,
                            fill=rim, outline="", tags="ui")               # 여는 홈
        gl = lerp_color(PANEL, WHITE, 0.75)
        cv.create_line(cx - r * 0.55, cy - r * 0.25, cx - r * 0.2, cy - r * 0.62,
                       fill=gl, width=lw, capstyle="round", tags="ui")     # 반짝임
        cv.create_line(cx - r * 0.62, cy + r * 0.05, cx - r * 0.5, cy - r * 0.08,
                       fill=gl, width=lw, capstyle="round", tags="ui")

    def draw_cloak_icon(self, cx, cy, size, item):
        """낡은 망토 — 해진 밑단과 접힌 주름, 목에 건 걸쇠."""
        cv = self.canvas
        col = ITEM_TIER_COLOR.get(item["tier"], MUT)
        cloth = lerp_color(PANEL, col, 0.42)
        rim = lerp_color(PANEL, col, 0.9)
        lw = max(1, size / 34)
        w = size * 0.36
        top, bot = cy - size * 0.34, cy + size * 0.30
        pts = [cx - w * 0.38, top, cx + w * 0.38, top,
               cx + w * 0.60, top + size * 0.10, cx + w, bot - size * 0.04]
        hem = (0.00, 0.06, 0.01, 0.05, 0.02, 0.07, 0.00)     # 해진 밑단 (오른쪽 → 왼쪽)
        for k, d in enumerate(hem):
            pts.extend((cx + w - 2 * w * (k + 0.5) / len(hem), bot + size * d))
        pts.extend((cx - w, bot - size * 0.04, cx - w * 0.60, top + size * 0.10))
        cv.create_polygon(*pts, fill=cloth, outline=rim, width=lw, tags="ui")
        for k in (-2, -1, 1, 2):                             # 주름
            cv.create_line(cx + k * w * 0.12, top + size * 0.10, cx + k * w * 0.42, bot,
                           fill=rim, width=lw, tags="ui")
        cv.create_polygon(cx + w * 0.30, cy + size * 0.02, cx + w * 0.52, cy - size * 0.04,
                          cx + w * 0.58, cy + size * 0.12, cx + w * 0.38, cy + size * 0.16,
                          fill=PANEL, outline=rim, width=lw, tags="ui")      # 찢어진 구멍
        cv.create_oval(cx - size * 0.05, top - size * 0.01, cx + size * 0.05, top + size * 0.09,
                       fill=lerp_color(PANEL, SPC, 0.55), outline=rim, width=lw, tags="ui")  # 걸쇠

    def draw_umbrella_icon(self, cx, cy, size, item):
        """헤진 우산 — 해진 가장자리와 찢긴 구멍이 있는 낡은 우산."""
        cv = self.canvas
        col = ITEM_TIER_COLOR.get(item["tier"], MUT)
        cloth = lerp_color(PANEL, col, 0.42)
        rim = lerp_color(PANEL, col, 0.9)
        lw = max(1, size / 34)
        R = size * 0.40
        by = cy - size * 0.02                       # 캐노피 아랫선
        top_y = by - R * 0.85
        pts = []
        for k in range(13):                         # 둥근 윗부분
            a = math.pi + math.pi * k / 12
            pts.extend((cx + R * math.cos(a), by + R * 0.85 * math.sin(a)))
        drop = (0.00, 0.07, 0.02, 0.09, 0.01, 0.06, 0.03)   # 해진 아랫단 (오른쪽 → 왼쪽)
        for k, d in enumerate(drop):
            pts.extend((cx + R - 2 * R * (k + 0.5) / len(drop), by + size * d))
        cv.create_polygon(*pts, fill=cloth, outline=rim, width=lw, tags="ui")
        for k in range(1, 4):                       # 살
            fx = cx - R + 2 * R * k / 4
            cv.create_line(cx, top_y, fx, by + size * 0.02, fill=rim, width=lw, tags="ui")
        hx, hy = cx - R * 0.45, by - R * 0.42       # 찢어진 구멍
        cv.create_polygon(hx, hy, hx + R * 0.22, hy - R * 0.1, hx + R * 0.3, hy + R * 0.2,
                          hx + R * 0.08, hy + R * 0.28, fill=PANEL, outline=rim, width=lw, tags="ui")
        cv.create_line(cx, by, cx, cy + size * 0.30, fill=rim, width=max(2, size / 24),
                       capstyle="round", tags="ui")                      # 손잡이 대
        hook = [cx, cy + size * 0.30, cx + size * 0.03, cy + size * 0.37, cx + size * 0.10, cy + size * 0.39,
                cx + size * 0.15, cy + size * 0.34]
        cv.create_line(*hook, fill=rim, width=max(2, size / 24), smooth=True,
                       capstyle="round", tags="ui")                      # 갈고리 손잡이

    def draw_stele(self, cx, cy, t, flash):
        """둥둥 떠 있는 비석 — 룬이 맥동하고 파편이 맴돈다."""
        cv = self.canvas
        bob = math.sin(t * 1.3) * 10
        x0, y0 = cx + math.sin(t * 0.7) * 3, cy + bob
        W, H = 78, 150
        glow = lerp_color("#9C8FEC", "#FFE9A8", max(0.0, min(1.0, flash)))
        k = 0.5 + 0.5 * math.sin(t * 1.3)                      # 높이가 높을수록 그림자는 작고 옅다
        sw = 96 - 22 * k
        cv.create_oval(cx - sw, cy + H + 60, cx + sw, cy + H + 76, fill="#05060A",
                       outline="", stipple="gray50", tags="ui")
        for i in range(4):                                       # 주변 기운
            r = 150 + i * 26 + 6 * math.sin(t + i)
            cv.create_oval(x0 - r, y0 - r * 1.1, x0 + r, y0 + r * 1.1,
                           outline=lerp_color("#07060D", glow, 0.10 + 0.05 * (4 - i) + 0.2 * flash),
                           width=2, tags="ui")

        top = []                                                 # 윗부분이 둥근 비석 외곽
        for j in range(9):
            ang = math.pi + math.pi * j / 8
            top.append((W * math.cos(ang), (-H + 60) + 60 * math.sin(ang)))
        outline = [(-W, H)] + top + [(W, H)]

        def pts(dx, dy):
            out = []
            for px, py in outline:
                out.extend((x0 + px + dx, y0 + py + dy))
            return out

        cv.create_polygon(*pts(16, -8), fill="#1A1D27", outline="#2C3040", width=2, tags="ui")
        cv.create_polygon(*pts(0, 0), fill="#2A2E3C", outline="#6B7090", width=2, tags="ui")
        cv.create_line(x0 - W + 3, y0 + H - 6, x0 - W + 3, y0 - H + 62, fill="#4A5070", width=2, tags="ui")
        for crack in (((-20, -60), (-8, -30), (-18, -5), (-4, 30)),
                      ((30, 20), (18, 52), (26, 80)), ((-40, 70), (-26, 92))):
            flat = []
            for px, py in crack:
                flat.extend((x0 + px, y0 + py))
            cv.create_line(*flat, fill="#12141C", width=3, tags="ui")
            cv.create_line(*flat, fill=lerp_color("#2A2E3C", glow, 0.35 + 0.3 * flash), width=1, tags="ui")

        gl = self.__dict__.get("_stele_glyphs")                 # 룬 문양 (고정 시드)
        if gl is None:
            rnd = random.Random(11)
            gl = []
            for _ in range(6):
                segs = []
                for _s in range(3):
                    segs.append((rnd.uniform(-12, 12), rnd.uniform(-12, 12),
                                 rnd.uniform(-12, 12), rnd.uniform(-12, 12)))
                gl.append(segs)
            self._stele_glyphs = gl
        for i, segs in enumerate(gl):
            gy = y0 - 62 + i * 30
            al = min(1.0, 0.3 + 0.45 * (0.5 + 0.5 * math.sin(t * 1.6 + i * 0.9)) + 0.5 * flash)
            for sx0, sy0, sx1, sy1 in segs:
                cv.create_line(x0 + sx0, gy + sy0 * 0.8, x0 + sx1, gy + sy1 * 0.8,
                               fill=lerp_color("#2A2E3C", glow, al), width=2, capstyle="round", tags="ui")
        gem_r = 9 + 2 * math.sin(t * 2.2)                        # 윗부분의 눈
        cv.create_oval(x0 - gem_r, y0 - H + 40 - gem_r, x0 + gem_r, y0 - H + 40 + gem_r,
                       fill=lerp_color("#2A2E3C", glow, 0.6 + 0.3 * flash), outline="#6B7090",
                       width=2, tags="ui")

        rnd = random.Random(5)                                   # 맴도는 파편
        for i in range(7):
            a0 = rnd.uniform(0, math.tau)
            rx = rnd.uniform(105, 140)
            ry = rnd.uniform(40, 80)
            spd = rnd.uniform(0.25, 0.5) * rnd.choice((-1, 1))
            sz = rnd.uniform(6, 12)
            rot = t * rnd.uniform(-1, 1) + a0
            ang = a0 + t * spd
            fx = x0 + math.cos(ang) * rx
            fy = y0 + math.sin(ang) * ry * 0.7 + math.sin(t * 1.3 + i) * 6
            q = []
            for dxy in ((0, -1.4), (1, 0.2), (0.4, 1.2), (-1, 0.3)):
                q.extend((fx + (dxy[0] * math.cos(rot) - dxy[1] * math.sin(rot)) * sz,
                          fy + (dxy[0] * math.sin(rot) + dxy[1] * math.cos(rot)) * sz))
            cv.create_polygon(*q, fill="#3A3F52", outline="#6B7090", width=1, tags="ui")

        for i in range(12):                                      # 떠오르는 빛 입자
            qq = (t * 0.25 + i / 12.0) % 1.0
            mx = x0 + math.sin(i * 2.1 + t) * 70
            my = y0 + H - qq * (2 * H + 40)
            s = 2.2
            cv.create_oval(mx - s, my - s, mx + s, my + s,
                           fill=lerp_color("#07060D", glow, (1 - qq) * 0.8), outline="", tags="ui")

    def render_workshop(self):
        self.buttons = []
        cv = self.canvas
        now = time.monotonic()
        if self.__dict__.get("_ws_since") is None:
            self._ws_since = now
            self._ws_ui = True
            self._ws_ui_since = now + 0.35                       # 비석이 먼저 나타나고 UI 가 뒤따라 열린다
        t = now - self._ws_since
        cv.create_rectangle(0, 0, WIN_W, WIN_H, fill="#000000", outline="", stipple="gray75", tags="ui")
        self.txt(MARGIN + 4, 22, "제작소", 30, TXT, bold=True, anchor="w")
        hint = "[Z] / [ESC] 닫기" if hasattr(self, "toggle_workshop") else "[ESC] 닫기"
        self.txt(WIN_W - MARGIN, 20, hint, 11, MUT, mono=True, anchor="ne")
        self.hbtn(WIN_W - MARGIN, 40, None, 24, "닫기", self.close_codex, MUT, anchor="ne")

        # 비석 (오른쪽)
        scx, scy = 830, 410
        flash = max(0.0, 1.0 - (now - self.__dict__.get("_ws_flash", -9.0)) / 0.9)
        if self.hover == ("wks", 1):
            flash = min(1.0, flash + 0.25)
        self.draw_stele(scx, scy, t, flash)
        self.buttons.append(dict(x=scx - 120, y=scy - 190, w=240, h=380, key=("wks", 1),
                                 cb=self.workshop_toggle_ui))
        self.txt(scx, 668, "비석을 누르면 창을 접고 펼 수 있다", 11, MUT, mono=True, anchor="center")

        # 제작 UI (비석 왼쪽 옆으로 흘러나온다)
        ui_open = self.__dict__.get("_ws_ui", True)
        p = max(0.0, min(1.0, (now - self._ws_ui_since) / 0.4))
        p = 1 - (1 - p) ** 3
        a = p if ui_open else 1.0 - p
        if a <= 0.02:
            return

        def fc(c):
            return lerp_color("#0B0A10", c, a)

        pw, ph = 560, 620
        px, py = 110 + (1 - a) * 70, 120
        cv.create_line(px + pw, py + ph / 2, scx - 84, scy, fill=fc("#4B3A92"), dash=(4, 6), tags="ui")
        cv.create_rectangle(px + 5, py + 5, px + pw + 5, py + ph + 5, fill="#05070A", outline="",
                            stipple="gray50", tags="ui")
        cv.create_rectangle(px, py, px + pw, py + ph, fill=fc(PANEL), outline=fc(SPC), width=2, tags="ui")
        cv.create_rectangle(px, py, px + pw, py + 5, fill=fc(SPC), outline="", tags="ui")
        self.txt(px + 24, py + 16, "제작", 24, fc(TXT), bold=True)
        self.txt(px + 24, py + 52, "재료를 바쳐 물건을 만든다", 11, fc(MUT), mono=True)
        cv.create_line(px + 20, py + 78, px + pw - 20, py + 78, fill=fc(BRD), tags="ui")

        inv = self.__dict__.get("inventory", {})
        rh = 124
        for i, rec in enumerate(WORKSHOP_RECIPES):
            item = ITEMS[rec["id"]]
            tc = ITEM_TIER_COLOR.get(item["tier"], MUT)
            rx, ry, rw = px + 20, py + 92 + i * (rh + 12), pw - 40
            cv.create_rectangle(rx, ry, rx + rw, ry + rh, fill=fc(PANEL2), outline=fc(BRD), tags="ui")
            cv.create_rectangle(rx + 14, ry + 14, rx + 106, ry + 106, fill=fc("#14181E"),
                                outline=fc(tc), tags="ui")
            if a > 0.8:
                self.draw_item_icon(rx + 60, ry + 58, 90, item)
            nf = self.font(20, bold=True)
            self.txt(rx + 122, ry + 12, item["name"], 20, fc(TXT), bold=True)
            self.txt(rx + 122 + nf.measure(item["name"]) + 10, ry + 18, "[%d T]" % item["tier"], 14,
                     fc(tc), mono=True, bold=True)
            self.txt(rx + 122, ry + 46, "%s  [제작 %d/%s]" % (item.get("effect", "효과: 없음"), inv.get(rec["id"], 0), rec.get("max", "∞")), 12, fc(MUT), mono=True)
            self.txt(rx + 122, ry + 72, "필요 재료", 11, fc(MUT), mono=True)
            enough = True
            my = ry + 94
            for mid, need in rec["cost"].items():
                have = inv.get(mid, 0)
                ok = have >= need
                enough = enough and ok
                mi = ITEMS[mid]
                if a > 0.8:
                    self.draw_item_icon(rx + 138, my + 10, 30, mi)
                self.txt(rx + 160, my, "%s  x%d     보유 %d" % (mi["name"], need, have), 13,
                         fc(HEAL if ok else DMG), bold=True)
                my += 22
            made = inv.get(rec["id"], 0)
            cap = rec.get("max")
            maxed = bool(cap) and made >= cap
            if maxed:
                enough = False
            bx, by, bw, bh = rx + rw - 122, ry + rh - 52, 108, 38
            hov = self.hover == ("wks", 10 + i)
            cv.create_rectangle(bx, by, bx + bw, by + bh,
                                fill=fc(PANEL2 if hov and enough else PANEL),
                                outline=fc(SPC if enough else BRD), width=2 if (hov and enough) else 1,
                                tags="ui")
            self.txt(bx + bw / 2, by + bh / 2, "제작" if enough else ("제작 완료" if maxed else "재료 부족"), 14,
                     fc(SPC if enough else MUT), bold=True, anchor="center")
            if a > 0.9:
                self.buttons.append(dict(x=bx, y=by, w=bw, h=bh, key=("wks", 10 + i),
                                         cb=(lambda r=rec["id"]: self.workshop_craft(r))))

        owned = "  ".join("%s x%d" % (ITEMS[r["id"]]["name"], inv.get(r["id"], 0))
                          for r in WORKSHOP_RECIPES)
        self.txt(px + 24, py + ph - 58, "제작품 보유: " + owned, 11, fc(MUT), mono=True)
        notice = self.__dict__.get("ws_notice", "")
        if notice:
            self.txt(px + 24, py + ph - 34, notice, 12, fc(SPC), mono=True)

    # ================================================================
    # ★★★★ 언더보스/C (어드민 전용 형상 — 언더보스 패치)
    # ================================================================
    def is_underboss(self, unit):
        return unit.side == "ally" and unit.aspect_id == "c_underboss"

    def find_aspect(self, aid):
        """형상 id 로 형상 데이터를 찾는다 (숨김 형상 포함)."""
        for _h in (UNDERBOSS_ASPECT, MAESTRO_ASPECT, BIGSIS_ASPECT, ORACLE_ASPECT):
            if aid == _h["id"]:
                return _h
        return next((a for a in ASPECTS if a["id"] == aid), None)

    def ub_reset(self, unit):
        unit.ub_foresight = 30
        unit.ub_overheat = -1
        unit.ub_ammo = UB_AMMO_MAX
        unit.ub_counter_round = None
        unit.ub_disposal_used = False
        unit.ub_refill_next = False
        unit.ub_refill_used = False

    def ub_range(self, unit):
        """예지 수치에 따른 회피 주사위 범위 (최소, 최대)."""
        f = unit.ub_foresight
        if unit.ub_overheat < 0 and f >= 25:
            return 5, 6
        if unit.ub_overheat < 0 and f >= 19:
            return 4, 5
        if unit.ub_overheat < 0 and f >= 13:
            return 3, 4
        return 1, 3

    def ub_shift(self, unit, delta):
        """예지 수치를 바꾼다. 0 이 되면 예지안 과열이 시작된다."""
        if unit.ub_overheat >= 0 or not unit.alive:
            return
        unit.ub_foresight = max(0, min(30, unit.ub_foresight + delta))
        self.fx_number(unit.id, "예지 %d" % unit.ub_foresight, UB_RED, 15, dy=-30)
        if unit.ub_foresight == 0:
            unit.ub_overheat = 0
            unit.ub_disposal_used = False
            self.log("%s의 예지가 바닥났다 — 예지안 과열 0. 스킬 3이 [처분]으로 변경." % unit.name, UB_RED)

    def ub_round_start(self, unit):
        if unit.ub_refill_next:
            unit.ub_refill_next = False
            unit.ub_disposal_used = False
            self.log("%s의 [처분]이 리필됐다." % unit.name, UB_RED)
        if unit.ub_overheat >= 0:
            unit.ub_overheat += 10
            self.log("%s의 예지안 과열 +10 (%d/30)." % (unit.name, unit.ub_overheat), UB_RED)
            if unit.ub_overheat >= 30:
                unit.ub_overheat = -1
                unit.ub_foresight = 30
                unit.ub_disposal_used = False
                self.log("%s의 예지안 과열이 가라앉았다 — 예지 30 복귀. 스킬 3 복귀." % unit.name, UB_RED)

    def ub_passive_evade(self, attacker, target, raw, fx, cb, no_break, hp_floor):
        """불완전한 예지안 — 공격당할 때 예지에 따른 주사위로 자동 회피한다."""
        lo, hi = self.ub_range(target)
        a, b = random.randint(lo, hi), d6()
        target.status = None

        def after():
            dodged = a == 6 or a > b
            self.log("%s의 불완전한 예지안 — 회피 판정 %d(%d~%d) vs %d → %s" %
                     (target.name, a, lo, hi, b, "완전 회피!" if dodged else "회피 실패"), UB_RED)
            if dodged:
                self.ub_shift(target, -3)             # 회피 성공시 예지 -3
                self.finalize(attacker, target, 0, "dodge",
                              lambda d: self.ub_counter(target, attacker, cb, d),
                              no_break=no_break, hp_floor=hp_floor)
            else:
                self.finalize(attacker, target, raw, fx, cb, no_break=no_break, hp_floor=hp_floor)

        self.dice_judge_overlay([("회피측", a), ("공격측", b)], after)

    def ub_counter(self, unit, attacker, cb, d=0):
        """회피 성공 — 1-2스킬 세치오나투라 디 코닐리오 (턴당 1회, 공격한 적에게 10 피해)."""
        if (attacker is None or attacker.side != "enemy" or not attacker.alive or not unit.alive
                or unit.ub_counter_round == self.round):
            cb(d)
            return
        unit.ub_counter_round = self.round
        self.log("%s의 [세치오나투라 디 코닐리오]! %s에게 반격한다." % (unit.name, attacker.name), UB_RED)
        self.fx_ub_lance(unit.id, attacker.id, ext=260)
        self.schedule(230, lambda: self.apply_damage(
            unit, attacker, 10, "hit",
            lambda dd: (self.log("   └ %s에게 %d 피해." % (attacker.name, dd), DMG), cb(d))))

    def ub_break_fixed(self, t, amount, name):
        """추가 격파 고정피해 — 격파체력을 직접 깎는다."""
        if amount <= 0 or not t.alive or t.broken:
            return
        t.brk = max(0, t.brk - amount)
        self.fx_number(t.id, "격파 -%d" % amount, BRKC, 16, dy=-30)
        self.log("[%s] 추가 격파 고정피해 %d." % (name, amount), BRKC)
        if t.brk == 0:
            t.broken = True
            t.broken_skips = 1
            self.log("💥 %s의 격파체력이 소진됐다 — 격파!" % t.name, BRKC)
            self.fx_break(t.id)

    # ================================================================
    # 언더보스/C 스킬 이펙트 — '거미집 엄지 아비 로쟈' 풍 (황금 / 진홍)
    # ================================================================
    def _ub_sparkle(self, cx, cy, n=8, spread=110, size=(7, 15), dur=0.7, cols=None):
        """네 갈래 반짝임(✦)이 커졌다가 사라진다."""
        cv = self.canvas
        cols = cols or (UB_GOLD_L, UB_GOLD, UB_CRIM)
        items, data = [], []
        for _ in range(n):
            a = random.random() * math.tau
            d = random.uniform(0.25, 1.0) * spread
            col = random.choice(cols)
            it = cv.create_polygon(cx, cy, cx, cy, cx, cy, cx, cy, cx, cy, cx, cy, cx, cy, cx, cy,
                                   fill=col, outline="", state="hidden", tags="fx")
            items.append(it)
            data.append((it, cx + math.cos(a) * d, cy + math.sin(a) * d * 0.8,
                         random.uniform(*size), random.uniform(0, 0.4), col))

        def up(p, e):
            for it, px, py, s, d0, col in data:
                q = (p - d0) / max(0.05, 1.0 - d0)
                if q <= 0.0 or q >= 1.0:
                    cv.itemconfig(it, state="hidden")
                    continue
                r = s * math.sin(math.pi * q)
                w = r * 0.28
                cv.coords(it, px, py - r, px + w, py - w, px + r, py, px + w, py + w,
                          px, py + r, px - w, py + w, px - r, py, px - w, py - w)
                cv.itemconfig(it, state="normal", fill=lerp_color(col, BG, q * q))

        self.add_fx(items, dur, up)

    def _ub_stroke(self, path, col_main, col_glow, dur=0.3, width=1.0):
        """path(꺾은선)를 따라 머리가 달리고 꼬리가 따라붙으며 사라지는 3겹 베기 궤적."""
        cv = self.canvas
        x0, y0 = path[0]

        def mk(col, w):
            return cv.create_line(x0, y0, x0, y0, fill=col, width=w * width, capstyle="round",
                                  smooth=True, state="hidden", tags="fx")

        layers = [(mk(col_glow, 17), 0.75, col_glow), (mk(col_main, 8), 0.58, col_main),
                  (mk(WHITE, 3), 0.42, WHITE)]

        def up(p, e):
            head = min(1.0, p / 0.58)
            fade = max(0.0, (p - 0.58) / 0.42)
            for ln, L, col in layers:
                tail = max(0.0, head - L) if p < 0.58 else (1.0 - L) + L * fade
                seg = self._fx_poly_slice(path, tail, head)
                if seg:
                    cv.coords(ln, *seg)
                    cv.itemconfig(ln, state="normal", fill=lerp_color(col, BG, fade * 0.9))
                else:
                    cv.itemconfig(ln, state="hidden")

        self.add_fx([l[0] for l in layers], dur, up)

    def _ub_crescent(self, cx, cy, rx, ry, a0, span, tilt, col_main, col_glow, dur=0.3, width=1.0):
        """타원 궤도를 도는 회전 베기 한 줄기."""
        ct, st = math.cos(tilt), math.sin(tilt)
        path = []
        for i in range(23):
            a = a0 + span * i / 22.0
            x, y = math.cos(a) * rx, math.sin(a) * ry
            path.append((cx + x * ct - y * st, cy + x * st + y * ct))
        self._ub_stroke(path, col_main, col_glow, dur, width)

    def fx_ub_spin(self, uid, turns=2, gap=110, scale=1.0):
        """회전 베기 — 황금/진홍 곡선이 번갈아 대상 주위를 휘감는다. 끝나는 시각(ms)을 돌려준다."""
        cx, cy = self.center_of(uid)
        for i in range(turns):
            def one(i=i):
                base = random.uniform(0, math.tau)
                tilt = random.uniform(-0.45, 0.45)
                gold = (i % 2 == 0)
                main, glow = (UB_GOLD_L, UB_GOLD) if gold else (UB_CRIM, UB_CRIM_D)
                r = random.uniform(95, 125) * scale
                self._ub_crescent(cx, cy, r, r * 0.55, base, math.radians(300), tilt,
                                  main, glow, dur=0.3)
                self._ub_crescent(cx, cy, r * 0.7, r * 0.4, base + math.pi, math.radians(260),
                                  tilt + 0.2,
                                  UB_CRIM if gold else UB_GOLD_L, UB_CRIM_D if gold else UB_GOLD,
                                  dur=0.26)
                self.fx_flash(uid, UB_GOLD if gold else UB_CRIM, "gray25")
                self.fx_particles(uid, main, n=6, spread=90 * scale, dur=0.35, size=3)
                self.shakes[uid] = 0.18
                beep([(random.randint(220, 340), 18)], self.sound)

            self.root.after(int(i * gap), one)
        return int((turns - 1) * gap + 220)

    def fx_ub_lance(self, src_uid, tgt_uid, ext=320, jitter=0.0, thick=1.0, dur=0.32):
        """찌르기 — 창끝이 대상을 꿰뚫고 그 너머까지 지나간다."""
        cv = self.canvas
        sx, sy = self.center_of(src_uid)
        tx, ty = self.center_of(tgt_uid)
        tx += random.uniform(-1, 1) * 30 * jitter
        ty += random.uniform(-1, 1) * 22 * jitter
        dx, dy = tx - sx, ty - sy
        ln = max(1.0, math.hypot(dx, dy))
        ux, uy = dx / ln, dy / ln
        px_, py_ = -uy, ux
        total = ln + ext

        def mk(col, w):
            return cv.create_line(sx, sy, sx, sy, fill=col, width=w * thick, capstyle="round",
                                  tags="fx")

        glow, mid, core = mk(UB_GOLD, 18), mk(UB_CRIM, 8), mk(WHITE, 3)
        side1, side2 = mk(UB_CRIM_D, 2), mk(UB_GOLD, 2)
        tip = cv.create_polygon(sx, sy, sx, sy, sx, sy, fill=UB_GOLD_L, outline=UB_GOLD,
                                width=1, tags="fx")

        def pos(d):
            return sx + ux * d, sy + uy * d

        def up(p, e):
            head = total * min(1.0, p * 2.2)
            fade = max(0.0, (p - 0.5) / 0.5)
            tail = max(0.0, head - 250) if p < 0.5 else max(0.0, total - 250) + 250 * fade
            tail = min(tail, head)
            (hx, hy), (qx, qy) = pos(head), pos(tail)
            for it in (glow, mid, core):
                cv.coords(it, qx, qy, hx, hy)
            cv.coords(side1, qx + px_ * 9, qy + py_ * 9, hx + px_ * 9, hy + py_ * 9)
            cv.coords(side2, qx - px_ * 9, qy - py_ * 9, hx - px_ * 9, hy - py_ * 9)
            cv.coords(tip, hx + ux * 22, hy + uy * 22, hx - ux * 8 + px_ * 8, hy - uy * 8 + py_ * 8,
                      hx - ux * 8 - px_ * 8, hy - uy * 8 - py_ * 8)
            for it, col in ((glow, UB_GOLD), (mid, UB_CRIM), (core, WHITE),
                            (side1, UB_CRIM_D), (side2, UB_GOLD)):
                cv.itemconfig(it, fill=lerp_color(col, BG, fade))
            cv.itemconfig(tip, state="hidden" if fade > 0.3 else "normal")

        self.add_fx([glow, mid, core, side1, side2, tip], dur, up)

        def hit():
            self.fx_flash(tgt_uid, UB_GOLD, "gray50")
            self.fx_particles(tgt_uid, UB_CRIM, n=12, spread=110, dur=0.45, size=3)
            self._ub_sparkle(tx, ty, n=4, spread=60, size=(6, 11), dur=0.45)
            self.shakes[tgt_uid] = 0.22
            beep([(random.randint(160, 240), 24)], self.sound)

        self.root.after(int(max(0.0, ln / total / 2.2) * dur * 1000), hit)

    def fx_ub_downslash(self, uid):
        """위에서 아래로 베며 지나간다."""
        cx, cy = self.center_of(uid)
        p0, p1, p2 = (cx - 90, cy - 185), (cx + 55, cy - 20), (cx + 75, cy + 205)
        path = []
        for i in range(21):
            q = i / 20.0
            path.append(((1 - q) ** 2 * p0[0] + 2 * (1 - q) * q * p1[0] + q * q * p2[0],
                         (1 - q) ** 2 * p0[1] + 2 * (1 - q) * q * p1[1] + q * q * p2[1]))
        self._ub_stroke(path, UB_GOLD_L, UB_CRIM, dur=0.36, width=1.3)
        side = [(x + 26, y - 10) for x, y in path]
        self._ub_stroke(side, UB_CRIM, UB_CRIM_D, dur=0.32, width=0.8)

        def impact():
            self.fx_flash(uid, UB_CRIM, "gray50")
            self.fx_particles(uid, UB_GOLD, n=16, spread=130, dur=0.5, size=4)
            self._ub_sparkle(cx, cy, n=6, spread=90, dur=0.55)
            self.shakes[uid] = 0.35
            beep([(180, 40), (110, 70)], self.sound)

        self.root.after(130, impact)

    def fx_ub_bigsweep(self, uid):
        """진홍색 대형 회전 베기 (영상 도입부)."""
        cx, cy = self.center_of(uid)
        self._ub_crescent(cx, cy, 190, 118, math.radians(200), math.radians(250), -0.35,
                          UB_CRIM, UB_CRIM_D, dur=0.5, width=1.7)
        self._ub_crescent(cx, cy, 150, 90, math.radians(30), math.radians(220), 0.3,
                          UB_GOLD_L, UB_GOLD, dur=0.42, width=1.2)
        self.fx_particles(uid, UB_CRIM, n=22, spread=170, dur=0.7, size=4)
        self.fx_flash(uid, UB_CRIM, "gray50")
        self.shakes[uid] = 0.3
        beep([(150, 50), (100, 90)], self.sound)

    def fx_ub_goldveil(self, uid, dur=0.9):
        """황금 빛무리 — 대상 주위가 주황빛으로 물든다."""
        cv = self.canvas
        cx, cy = self.center_of(uid)
        veil = cv.create_oval(cx, cy, cx, cy, fill=lerp_color(BG, UB_GOLD, 0.45), outline="",
                              stipple="gray25", tags="fx")
        ring = cv.create_oval(cx, cy, cx, cy, outline=UB_GOLD, width=4, tags="fx")
        ring2 = cv.create_oval(cx, cy, cx, cy, outline=UB_GOLD_L, width=2, tags="fx")

        def up(p, e):
            grow = min(1.0, p * 3.0)
            r = 40 + 150 * grow + 6 * math.sin(p * 18)
            fade = max(0.0, (p - 0.6) / 0.4)
            cv.coords(veil, cx - r * 1.25, cy - r * 0.8, cx + r * 1.25, cy + r * 0.8)
            cv.itemconfig(veil, fill=lerp_color(BG, UB_GOLD, 0.45 * (1 - fade)))
            cv.coords(ring, cx - r, cy - r * 0.62, cx + r, cy + r * 0.62)
            cv.coords(ring2, cx - r * 0.72, cy - r * 0.45, cx + r * 0.72, cy + r * 0.45)
            cv.itemconfig(ring, outline=lerp_color(UB_GOLD, BG, fade))
            cv.itemconfig(ring2, outline=lerp_color(UB_GOLD_L, BG, fade))

        self.add_fx([veil, ring, ring2], dur, up)

    def fx_ub_beam(self, uid):
        """화면을 가로지르는 붉은 관통선 + X자 참격 (영상 마지막 장면)."""
        cv = self.canvas
        tx, ty = self.center_of(uid)
        dur = 1.0

        def ln(col, w, y=ty):
            return cv.create_line(0, y, 0, y, fill=col, width=w, capstyle="round", tags="fx")

        glow, mid = ln(UB_CRIM_D, 34), ln(UB_CRIM, 16)
        core, white = ln(UB_GOLD_L, 6), ln(WHITE, 2)
        offs = [(ln(col, w, ty + dy), dy, col, w)
                for dy, col, w in ((-17, UB_CRIM, 3), (14, UB_GOLD, 3),
                                   (-31, UB_CRIM_D, 2), (28, UB_CRIM, 2))]
        xs = []
        for sgn in (1, -1):
            a = cv.create_line(tx, ty, tx, ty, fill=UB_CRIM, width=7, capstyle="round",
                               state="hidden", tags="fx")
            b = cv.create_line(tx, ty, tx, ty, fill=WHITE, width=2, capstyle="round",
                               state="hidden", tags="fx")
            xs.append((a, b, sgn))
        items = [glow, mid, core, white] + [o[0] for o in offs] + [i for x in xs for i in x[:2]]

        def up(p, e):
            head = WIN_W * min(1.0, p * 3.5)
            fade = max(0.0, (p - 0.55) / 0.45)
            for it in (glow, mid, core, white):
                cv.coords(it, 0, ty, head, ty)
            for it, dy, col, w in offs:
                cv.coords(it, head * 0.12, ty + dy, head, ty + dy)
                cv.itemconfig(it, fill=lerp_color(col, BG, fade))
            for it, col, w in ((glow, UB_CRIM_D, 34), (mid, UB_CRIM, 16),
                               (core, UB_GOLD_L, 6), (white, WHITE, 2)):
                cv.itemconfig(it, fill=lerp_color(col, BG, fade), width=max(1, w * (1 - 0.85 * fade)))
            q = max(0.0, min(1.0, (p - 0.12) / 0.2))
            for a, b, sgn in xs:
                if q <= 0:
                    continue
                for it in (a, b):
                    cv.coords(it, tx - sgn * 90 * q, ty - 170 * q, tx + sgn * 90 * q, ty + 170 * q)
                    cv.itemconfig(it, state="normal")
                cv.itemconfig(a, fill=lerp_color(UB_CRIM, BG, fade))
                cv.itemconfig(b, fill=lerp_color(WHITE, BG, fade))

        self.add_fx(items, dur, up)

        def impact():
            self.fx_flash(uid, WHITE, "gray50")
            self.fx_particles(uid, UB_CRIM, n=26, spread=190, dur=0.7, size=4)
            self.fx_particles(uid, UB_GOLD, n=12, spread=120, dur=0.6, size=3)
            self._ub_sparkle(tx, ty, n=9, spread=150, dur=0.8)
            self.shakes[uid] = 0.5
            beep([(200, 60), (120, 120)], self.sound)

        self.root.after(int(tx / float(WIN_W) / 3.5 * dur * 1000), impact)
        self.root.after(520, lambda: self._ub_sparkle(tx, ty, n=7, spread=200, dur=0.8))

    def fx_ub_skill(self, kind, src, tgt):
        """스킬별 이펙트를 시작하고, 피해가 들어갈 시점(ms)을 돌려준다."""
        if kind == "ub_colpi":                                   # 스킬 1 — 회전 베기 2연속
            return self.fx_ub_spin(tgt, 2, 110)
        if kind == "ub_pierce":                                  # 스킬 2 — 5연속 찌르기 → 내려베기
            for i in range(5):
                self.root.after(i * 85, lambda: self.fx_ub_lance(
                    src, tgt, ext=240, jitter=1.0, thick=0.8, dur=0.26))
            self.root.after(5 * 85 + 40, lambda: self.fx_ub_downslash(tgt))
            return 5 * 85 + 40 + 150
        if kind == "ub_cervo":                                   # 스킬 2-2 — 더 길게 회전 베기
            return self.fx_ub_spin(tgt, 6, 90, 1.1)
        if kind == "ub_elephant":                                # 스킬 3 — 관통 → 8연속 회전 베기
            self.fx_ub_lance(src, tgt, ext=340, thick=1.4, dur=0.34)
            self.root.after(380, lambda: self.fx_ub_spin(tgt, 8, 75, 1.1))
            return 380 + 7 * 75 + 220
        if kind == "ub_disposal":                                # 스킬 3-2 — 영상 재현
            self.fx_ub_bigsweep(tgt)
            self.root.after(300, lambda: (self.fx_ub_goldveil(tgt), self.fx_ub_spin(tgt, 3, 150, 1.5),
                                          self._ub_sparkle(*self.center_of(tgt), n=8, spread=170)))
            self.root.after(900, lambda: self.fx_ub_spin(tgt, 4, 85, 1.25))
            self.root.after(1350, lambda: self.fx_ub_beam(tgt))
            return 1500
        self.fx_ub_lance(src, tgt)
        return 300

    def execute_underboss(self, u, sk, plan, done):
        t = self.valid_target(u, plan, "enemy")
        if not t or t.side != "enemy":
            self.schedule(300, done)
            return
        kind = sk["kind"]
        if kind == "ub_disposal":                        # 사용시 가속탄 10 획득
            before = u.ub_ammo
            u.ub_ammo = min(UB_AMMO_MAX, u.ub_ammo + 10)
            u.ub_disposal_used = True
            self.log("[처분] 가속탄 재장전 (%d → %d)." % (before, u.ub_ammo), SPC)
        ammo_ok = False
        need = sk.get("ammo", 0)
        if need:
            if u.ub_ammo >= need:
                u.ub_ammo -= need
                ammo_ok = True
                self.fx_number(u.id, "가속탄 %d" % u.ub_ammo, SPC, 14, dy=-26)
            else:
                self.log("가속탄이 부족하다 — 추가효과가 발동하지 않는다.", MUT)
        dmg = sk["dmg"]
        doubled = False
        if kind == "ub_elephant":                        # ub_foresight_cost: 스킬 3 — 예지 -5, 소비한 가속탄만큼 추가 감소 (최대 10)
            _spent = need if ammo_ok else 0
            _drop = min(10, 5 + _spent)
            self.log("[%s] 예지 -%d (기본 5 + 가속탄 소비 %d)." % (sk["name"], _drop, _spent), UB_RED)
            self.ub_shift(u, -_drop)
        if kind == "ub_disposal" and t.hp <= t.max_hp * 0.5:
            dmg *= 2
            doubled = True
        if sk.get("line"):
            self.log("%s: %s" % (u.name, sk["line"]), UB_RED)

        def after(dealt):
            self.log("%s의 [%s]! %s에게 %d 피해%s." %
                     (u.name, sk["name"], t.name, dealt, " (체력 50% 이하 — 피해 2배)" if doubled else ""),
                     UB_RED)

            def tail():
                if kind == "ub_disposal" and not t.alive and not u.ub_refill_used:
                    u.ub_refill_used = True
                    u.ub_refill_next = True
                    self.log("[처분]으로 적을 처치했다 — 다음 턴 [처분]이 리필된다.", UB_RED)
                done()

            if ammo_ok and sk.get("extra_brk"):
                self.ub_break_fixed(t, sk["extra_brk"], sk["name"])
            if sk.get("fixed_dmg") and t.alive:
                self.apply_damage(u, t, sk["fixed_dmg"], "fixed",
                                  lambda fd: (self.log("[%s] 고정피해 %d." % (sk["name"], fd), UB_RED),
                                              tail()), fixed=True)
            else:
                tail()

        fx = sk.get("fx", "bullet")
        heavy = fx in ("snipe", "frenzy") or kind in ("ub_pierce", "ub_elephant")

        def hit():
            self.apply_damage(u, t, dmg, "heavy" if heavy else "hit", after)

        self.schedule(self.fx_ub_skill(kind, u.id, t.id), hit)

    def admin_equip_underboss(self):
        unit = self.units.get("C")
        if not unit or unit.side != "ally":
            return
        unit.fate_hp_spent = 0
        unit.fate_ready = False
        unit.hero_buff = False
        unit.hero_revive_used = False
        unit.hero_passive_shield_gained = 0
        unit.hero_echo_used = False
        unit.hero_echo_channel = None
        unit.imperial_prayer = 0
        unit.imperial_princess = False
        unit.imperial_command_used = False
        unit.imperial_guardian_round = None
        unit.imperial_safety_round = None
        unit.aspect_id = UNDERBOSS_ASPECT["id"]
        unit.skills = UNDERBOSS_ASPECT["skills"]
        unit.max_sp = MAX_SP
        unit.sp = min(unit.sp, unit.max_sp)
        self.ub_reset(unit)
        self.log("[ADMIN] C에게 [언더보스/C] 형상을 장착했다. (이번 전투 한정)", UB_RED)
        self.fx_flash(unit.id, UB_RED, "gray50")
        beep([(220, 60), (330, 70), (440, 120)], self.sound)
        self.render()

    def admin_unequip_underboss(self):
        unit = self.units.get("C")
        if not unit or not self.is_underboss(unit):
            return
        aid = self.__dict__.get("equipped", {}).get("C", "c_base")
        self.equip_aspect(aid)
        self.log("[ADMIN] 언더보스/C 장착을 해제했다.", UB_RED)
        self.render()

